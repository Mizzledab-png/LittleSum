--// Services
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local lp = Players.LocalPlayer
local cam = workspace.CurrentCamera

--// Lock State
local locked = false
local enemy = nil
local holdingAlt = false

--// Precision-Sniper Hybrid Tuning
local MAX_SCREEN_DIST = 240
local LEAD_TIME = 0.165          -- longer = more stable long-range prediction
local STRAFE_BIAS = 0.34         -- reduced lateral aggression for precision

--// Prediction State
local lastVel = nil
local accel = Vector3.zero

local function resetPredictionState()
    lastVel = nil
    accel = Vector3.zero
end

--// Closest Player to Cursor
local function getClosestPlayerToCursor()
    local mousePos = UserInputService:GetMouseLocation()
    local closest = nil
    local closestDist = MAX_SCREEN_DIST

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = plr.Character.HumanoidRootPart
            local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)

            if onScreen then
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = plr.Character
                end
            end
        end
    end

    return closest
end

--// Auto-Unlock
local function bindAutoUnlock(character)
    if not character then return end

    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Died:Connect(function()
            locked = false
            enemy = nil
            resetPredictionState()
        end)
    end

    character.ChildRemoved:Connect(function(child)
        if child.Name == "HumanoidRootPart" then
            locked = false
            enemy = nil
            resetPredictionState()
        end
    end)
end

--// Input Handling
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    if input.KeyCode == Enum.KeyCode.LeftAlt then
        holdingAlt = true
        enemy = getClosestPlayerToCursor()

        if enemy then
            locked = true
            bindAutoUnlock(enemy)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.LeftAlt then
        holdingAlt = false
        locked = false
        enemy = nil
        resetPredictionState()
    end
end)

--// Precision-Sniper Hybrid Tracking Loop
RunService.RenderStepped:Connect(function(dt)
    if locked and holdingAlt and enemy and enemy:FindFirstChild("HumanoidRootPart") then
        
        local hrp = enemy.HumanoidRootPart
        local head = enemy:FindFirstChild("Head")
        local targetPos = head and head.Position or (hrp.Position + Vector3.new(0, 1.6, 0))

        -- RAW velocity
        local vel = hrp.AssemblyLinearVelocity

        -- Ultra-tight vertical clamp (sniper stability)
        local verticalVel = math.clamp(vel.Y, -3, 3)

        -- Precision lateral velocity (low aggression)
        local camLook = cam.CFrame.LookVector
        local lateralVel = vel - (vel:Dot(camLook) * camLook)
        lateralVel *= STRAFE_BIAS

        local biasedVel = Vector3.new(
            lateralVel.X,
            verticalVel,
            lateralVel.Z
        )

        -- RAW acceleration
        if lastVel then
            accel = (vel - lastVel) / dt
        end
        lastVel = vel

        -- Precision acceleration clamp (sniper micro-corrections)
        accel = Vector3.new(
            math.clamp(accel.X, -26, 26),
            math.clamp(accel.Y, -6, 6),
            math.clamp(accel.Z, -26, 26)
        )

        -- Prediction window
        local t = LEAD_TIME

        -- Precision lateral scaling (stable long-range tracking)
        local lateralScaled = Vector3.new(
            biasedVel.X * 0.28,
            biasedVel.Y,
            biasedVel.Z * 0.28
        )

        local predictedPos =
            targetPos +
            lateralScaled * t +
            0.5 * accel * (t ^ 2)

        -- Instant snap (no smoothing)
        cam.CFrame = CFrame.new(cam.CFrame.Position, predictedPos)
    end
end)
