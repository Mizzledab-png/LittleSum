--// Services
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local lp = Players.LocalPlayer
local cam = workspace.CurrentCamera

--// Lock State
local locked = false
local enemy = nil
local holdingAlt = false

--// Raw Precision Tracking (NO SMOOTHING)
local MAX_SCREEN_DIST = 200
local LEAD_TIME = 0.18
local STRAFE_BIAS = 1.17

--// Prediction State (No smoothing)
local lastVel = nil
local accel = Vector3.zero

local function resetPredictionState()
    lastVel = nil
    accel = Vector3.zero
end

--// Closest Player to Cursor
local function getClosestPlayerToCursor()
    local mousePos = UserInputService:GetMouseLocation()
    local closest = nil
    local closestDist = MAX_SCREEN_DIST

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = plr.Character.HumanoidRootPart
            local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)

            if onScreen then
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = plr.Character
                end
            end
        end
    end

    return closest
end

--// Auto-Unlock
local function bindAutoUnlock(character)
    if not character then return end

    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Died:Connect(function()
            locked = false
            enemy = nil
            resetPredictionState()
        end)
    end

    character.ChildRemoved:Connect(function(child)
        if child.Name == "HumanoidRootPart" then
            locked = false
            enemy = nil
            resetPredictionState()
        end
    end)
end

--// Input Handling
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    if input.KeyCode == Enum.KeyCode.LeftAlt then
        holdingAlt = true
        enemy = getClosestPlayerToCursor()

        if enemy then
            locked = true
            bindAutoUnlock(enemy)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.LeftAlt then
        holdingAlt = false
        locked = false
        enemy = nil
        resetPredictionState()
    end
end)

--// RAW Precision Tracking Loop (NO SMOOTHING ANYWHERE)
RunService.RenderStepped:Connect(function(dt)
    if locked and holdingAlt and enemy and enemy:FindFirstChild("HumanoidRootPart") then
        
        local hrp = enemy.HumanoidRootPart
        local head = enemy:FindFirstChild("Head")
        local targetPos = head and head.Position or (hrp.Position + Vector3.new(0, 1.6, 0))

        -- RAW velocity
        local vel = hrp.AssemblyLinearVelocity

        -- Vertical clamp (keeps camera from bouncing)
        local verticalVel = math.clamp(vel.Y, -12, 12)

        -- RAW lateral velocity (no smoothing)
        local camLook = cam.CFrame.LookVector
        local lateralVel = vel - (vel:Dot(camLook) * camLook)
        lateralVel *= STRAFE_BIAS

        local biasedVel = Vector3.new(
            lateralVel.X,
            verticalVel,
            lateralVel.Z
        )

        -- RAW acceleration (no smoothing)
        if lastVel then
            accel = (vel - lastVel) / dt
        end
        lastVel = vel

        -- RAW second-order prediction
        local t = LEAD_TIME

        local lateralScaled = Vector3.new(
            biasedVel.X * 0.42,
            biasedVel.Y,
            biasedVel.Z * 0.42
        )

        local predictedPos =
            targetPos +
            lateralScaled * t +
            0.5 * accel * (t ^ 2)

        -- NO smoothing, NO lerp — instant snap
        cam.CFrame = CFrame.new(cam.CFrame.Position, predictedPos)
    end
end)
