--// SERVICES
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local lp = Players.LocalPlayer
local cam = workspace.CurrentCamera

--// LOCK STATE
local locked = false
local holdingAlt = false

local enemyChar = nil
local enemyHum = nil
local enemyHRP = nil
local enemyHead = nil

--// BASE TUNING
local MAX_SCREEN_DIST = 240

--// RAYCAST
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Blacklist

--// VALIDITY CHECK
local function IsValidEnemy()
    if not enemyChar or not enemyChar.Parent then return false end
    if not enemyHum or enemyHum.Health <= 0 then return false end
    if not enemyHRP or not enemyHRP.Parent then return false end
    return true
end

--// CLOSEST PLAYER TO CURSOR
local function getClosestPlayerToCursor()
    local mousePos = UserInputService:GetMouseLocation()
    local closestChar = nil
    local closestDist = MAX_SCREEN_DIST

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local dx = screenPos.X - mousePos.X
                    local dy = screenPos.Y - mousePos.Y
                    local dist = math.sqrt(dx*dx + dy*dy)

                    if dist < closestDist then
                        closestDist = dist
                        closestChar = plr.Character
                    end
                end
            end
        end
    end

    return closestChar
end

--// AUTO UNLOCK
local function bindAutoUnlock(character)
    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Died:Connect(function()
            locked = false
            enemyChar = nil
            enemyHum = nil
            enemyHRP = nil
            enemyHead = nil
        end)
    end

    character.ChildRemoved:Connect(function(child)
        if child.Name == "HumanoidRootPart" then
            locked = false
            enemyChar = nil
            enemyHum = nil
            enemyHRP = nil
            enemyHead = nil
        end
    end)
end

--// SET ENEMY
local function setEnemy(character)
    enemyChar = character
    enemyHum = character:FindFirstChildOfClass("Humanoid")
    enemyHRP = character:FindFirstChild("HumanoidRootPart")
    enemyHead = character:FindFirstChild("Head")

    if enemyChar and enemyHRP then
        rayParams.FilterDescendantsInstances = { lp.Character, enemyChar }
        bindAutoUnlock(enemyChar)
        locked = true
    else
        locked = false
        enemyChar = nil
        enemyHum = nil
        enemyHRP = nil
        enemyHead = nil
    end
end

--// INPUT
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    if input.KeyCode == Enum.KeyCode.LeftAlt then
        holdingAlt = true
        local char = getClosestPlayerToCursor()
        if char then setEnemy(char) end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.LeftAlt then
        holdingAlt = false
        locked = false
        enemyChar = nil
        enemyHum = nil
        enemyHRP = nil
        enemyHead = nil
    end
end)

---------------------------------------------------------------------
-- TRUE HARD‑LOCK (CORRECT VERSION)
-- Camera instantly rotates to face the enemy head
---------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    if not locked or not holdingAlt then return end
    if not IsValidEnemy() then
        locked = false
        enemyChar = nil
        enemyHum = nil
        enemyHRP = nil
        enemyHead = nil
        return
    end

    local head = enemyHead or enemyHRP
    local targetPos = head.Position

    -- Camera position stays the same, rotation snaps to target
    local camPos = cam.CFrame.Position
    cam.CFrame = CFrame.new(camPos, targetPos)
end)
