--// SERVICES
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

repeat task.wait() until workspace.CurrentCamera
local cam = workspace.CurrentCamera

local lp = Players.LocalPlayer

--// LOCK STATE
local locked = false
local holdingAlt = false

local enemyChar = nil
local enemyHum = nil
local enemyHRP = nil
local enemyHead = nil

--// VALIDITY CHECK
local function IsValidEnemy()
    if not enemyChar or not enemyChar.Parent then return false end
    if not enemyHum or enemyHum.Health <= 0 then return false end
    if not enemyHRP or not enemyHRP.Parent then return false end
    return true
end

--// CLOSEST PLAYER TO CURSOR
local function getClosestPlayerToCursor()
    local mousePos = UserInputService:GetMouseLocation()
    local closestChar = nil
    local closestDist = 240

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local dx = screenPos.X - mousePos.X
                    local dy = screenPos.Y - mousePos.Y
                    local dist = math.sqrt(dx*dx + dy*dy)

                    if dist < closestDist then
                        closestDist = dist
                        closestChar = plr.Character
                    end
                end
            end
        end
    end

    return closestChar
end

--// AUTO UNLOCK
local function bindAutoUnlock(character)
    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Died:Connect(function()
            locked = false
            enemyChar = nil
            enemyHum = nil
            enemyHRP = nil
            enemyHead = nil
        end)
    end
end

--// SET ENEMY
local function setEnemy(character)
    enemyChar = character
    enemyHum = character:FindFirstChildOfClass("Humanoid")
    enemyHRP = character:FindFirstChild("HumanoidRootPart")
    enemyHead = character:FindFirstChild("Head")

    if enemyChar and enemyHRP then
        bindAutoUnlock(enemyChar)
        locked = true
    else
        locked = false
        enemyChar = nil
        enemyHum = nil
        enemyHRP = nil
        enemyHead = nil
    end
end

--// INPUT
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    if input.KeyCode == Enum.KeyCode.LeftAlt then
        holdingAlt = true
        local char = getClosestPlayerToCursor()
        if char then setEnemy(char) end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.LeftAlt then
        holdingAlt = false
        locked = false
        enemyChar = nil
        enemyHum = nil
        enemyHRP = nil
        enemyHead = nil
    end
end)

---------------------------------------------------------------------
-- PREDICTION SETTINGS
---------------------------------------------------------------------
local predictionTime = 0.18 -- adjust 0.08–0.18 depending on game speed

local function getPredictedPosition()
    if not enemyHRP then return nil end

    local vel = enemyHRP.AssemblyLinearVelocity
    local head = enemyHead or enemyHRP
    local basePos = head.Position

    return basePos + (vel * predictionTime)
end

---------------------------------------------------------------------
-- RAW CAMERA LOCK + PREDICTION
---------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    if not locked or not holdingAlt then return end
    if not IsValidEnemy() then
        locked = false
        enemyChar = nil
        enemyHum = nil
        enemyHRP = nil
        enemyHead = nil
        return
    end

    local predictedPos = getPredictedPosition()
    if not predictedPos then return end

    cam.CFrame = CFrame.new(cam.CFrame.Position, predictedPos)
end)
