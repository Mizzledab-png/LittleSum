local function roundify(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = obj
end

local function addStroke(obj, thickness, color, transparency)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1
    s.Color = color or Color3.fromRGB(0,0,0)
    s.Transparency = transparency or 0.4
    s.Parent = obj
end

local Cooldown = {}
Cooldown.__index = Cooldown
function Cooldown.new(t)
    return setmetatable({time = t, last = 0}, Cooldown)
end
function Cooldown:ready()
    local now = tick()
    if now - self.last >= self.time then
        self.last = now
        return true
    end
end

local function getRoot()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart", 2)
end

local VehicleCache = {}
local function getPrimary(car)
    if not car then return end
    if not VehicleCache[car] or not VehicleCache[car].Parent then
        VehicleCache[car] = car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart", true)
    end
    return VehicleCache[car]
end

local function getAttr(car, name, default)
    local v = car:GetAttribute(name)
    return v ~= nil and v or default
end

local UICleaner = {}
UICleaner.__index = UICleaner
function UICleaner.new()
    return setmetatable({items = {}}, UICleaner)
end
function UICleaner:add(obj)
    if obj then table.insert(self.items, obj) end
end
function UICleaner:clear()
    for _,o in ipairs(self.items) do
        if o.Destroy then
            o:Destroy()
        end
    end
    self.items = {}
end

local Mode = {current = "NONE"}
function Mode:set(m) self.current = m end
function Mode:is(m) return self.current == m end

local function tween(obj, props, time, style, dir)
    local ti = TweenInfo.new(
        time or 0.25,
        style or Enum.EasingStyle.Sine,
        dir or Enum.EasingDirection.Out
    )
    TweenService:Create(obj, ti, props):Play()
end

local function safe(fn)
    local ok,err = pcall(fn)
    if not ok then
        warn("[AUTEL] Error:", err)
    end
end

local function sortByDistance(rootPos, cars)
    table.sort(cars, function(a,b)
        local pa,pb = getPrimary(a), getPrimary(b)
        if not pa or not pb then return false end
        return (pa.Position - rootPos).Magnitude < (pb.Position - rootPos).Magnitude
    end)
end

local Signal = {}
Signal.__index = Signal
function Signal.new()
    return setmetatable({callbacks = {}}, Signal)
end
function Signal:connect(fn)
    table.insert(self.callbacks, fn)
end
function Signal:fire(...)
    for _,fn in ipairs(self.callbacks) do
        fn(...)
    end
end

