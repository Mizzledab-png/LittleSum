        progressLabel.Text = "<font color='rgb(255,60,60)'>▂▂▂▂▂▂▂▂▂▂</font>"
        setText("<b>ECU OVERRIDE SUITE</b>\n\n<font color='rgb(0,255,0)'>BREACH COMPLETE</font>")
        status.Text = "Status: ECU // COMPLETE"
    end)
end

