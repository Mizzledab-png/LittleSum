local navButtons = {}

local function makeNavButton(name, order, label)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(1,0,0,32)
    btn.BackgroundColor3 = CONFIG.Theme.NavIdle
    btn.BorderSizePixel = 0
    btn.TextColor3 = CONFIG.Theme.TextSecondary
    btn.TextScaled = true
    btn.Font = Enum.Font.GothamBold
    btn.Text = label or name
    btn.AutoButtonColor = false
    btn.LayoutOrder = order
    btn.Parent = nav
    roundify(btn, 8)

    btn.MouseEnter:Connect(function()
        if not Mode:is(name) then
            tween(btn, {BackgroundColor3 = CONFIG.Theme.NavActive}, 0.12)
        end
    end)
    btn.MouseLeave:Connect(function()
        if not Mode:is(name) then
            tween(btn, {BackgroundColor3 = CONFIG.Theme.NavIdle}, 0.12)
        end
    end)

    navButtons[name] = btn
    return btn
end

local function highlightNav(name)
    for n,btn in pairs(navButtons) do
        local active = (n == name)
        tween(btn, {
            BackgroundColor3 = active and CONFIG.Theme.NavActive or CONFIG.Theme.NavIdle,
            TextColor3       = active and CONFIG.Theme.TextPrimary or CONFIG.Theme.TextSecondary
        }, 0.12)
    end
    Mode:set(name)
end

