local function tween(o,p,t)
    return ts:Create(o, TweenInfo.new(t or .25, Enum.EasingStyle.Quad), p)
end

local function isValidCarName(name)
    if not name then return false end
    name = name:lower()
    return name ~= "body" and name ~= "model" and name ~= "futon"
end

-- Prebuilt signal bar strings to avoid rebuilding patterns
local SIGNAL_STRONG   = "<font color='rgb(0,255,0)'>˒﹚)</font>"
local SIGNAL_MEDIUM_2 = "<font color='rgb(255,255,0)'>˒﹚</font>"
local SIGNAL_MEDIUM_1 = "<font color='rgb(255,255,0)'>˒</font>"
local SIGNAL_WEAK     = "<font color='rgb(255,0,0)'>-</font>"

local function getSignalBars(dist)
    if dist <= 50 then
        return SIGNAL_STRONG
    elseif dist <= 100 then
        return SIGNAL_MEDIUM_2
    elseif dist <= 150 then
        return SIGNAL_MEDIUM_1
    else
        return SIGNAL_WEAK
    end
end

local function getProgressBar(pct)
    local filled = math.floor(pct/10)
    local empty = 10 - filled
    local bar = ""

    for _ = 1,filled do
        bar ..= "<font color='rgb(0,255,0)'>▂</font>"
    end
    for _ = 1,empty do
        bar ..= "<font color='rgb(60,60,60)'>▂</font>"
    end

    return bar
end

-- Cached root for performance
local currentRoot

local function updateRoot()
    local char = plr.Character
    if not char then
        currentRoot = nil
        return
    end
    currentRoot = char:FindFirstChild("HumanoidRootPart")
end

plr.CharacterAdded:Connect(function(char)
    char:WaitForChild("HumanoidRootPart")
    updateRoot()
end)

-- Initial root
updateRoot()

local function root()
    return currentRoot
end

