end

local function exitAndReset()
    isLinked = false
    updateLinkStatus()
    sonarManager:clearAll()

    Mode:set("NONE")
    highlightNav("NONE")
    ModeChanged:fire("NONE")

    spoofedKeys    = {}
    lastScannedCar = nil
    scanList       = {}
    scanIndex      = 1

    prevBtn.Visible = false
    nextBtn.Visible = false

    syncStatus("Closed", CONFIG.Theme.StatusWarn)
    syncMain("Select a module on the left.")

    tween(tablet, {BackgroundTransparency = 1}, 0.15)
    tablet.Visible = false
    syncVisibility()
    tablet.BackgroundTransparency = 0
end

