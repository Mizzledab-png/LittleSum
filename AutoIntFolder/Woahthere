local function ENCRYPTEDKEY()
    clearSonarUI()

    if not lastCar or not lastCar.Parent then
        setText("ENCRYPTED KEY FOB\n\nNo target selected.\nUse Connections first.")
        status.Text = "Status: Idle"
        return
    end

    local p = VM.primary[lastCar]
    if not p then
        setText("ENCRYPTED KEY FOB\n\nVehicle missing primary part.")
        return
    end

    local ok, r = pcall(root)
    if not ok or not r or not r.Parent then return end

    local dist = (p.Position - r.Position).Magnitude
    if dist > 120 then
        setText("ENCRYPTED KEY FOB\n\nOut of range.\nMove closer to the vehicle.")
        status.Text = "Status: Out of range"
        return
    end

    -- rolling code seed
    local seed = lastCar:GetAttribute("KeySeed")
    if not seed then
        seed = math.random(100000,999999)
        lastCar:SetAttribute("KeySeed", seed)
    end

    -- challenge code
    local challenge = math.random(10000,99999)
    lastCar:SetAttribute("Challenge", challenge)

    setText((
        "ENCRYPTED KEY FOB\n\nVehicle: %s\nRange OK (%d studs)\n\nChallenge Code: %d\n\nSelect an action:"
    ):format(lastCar.Name, math.floor(dist), challenge))

    status.Text = "Status: Encrypted Ready"

    local function makeAction(name, order, callback)
        local b = Instance.new("TextButton", panel)
        b.Size = UDim2.new(1,-16,0,30)
        b.Position = UDim2.new(0,8,0,180 + (order*34))
        b.BackgroundColor3 = Color3.fromRGB(20,20,26)
        b.Font = Enum.Font.GothamBold
        b.TextColor3 = Color3.fromRGB(240,240,245)
        b.TextScaled = true
        b.Text = name
        Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)

        b.MouseEnter:Connect(function()
            tween(b,{BackgroundColor3=CFG.Col},.15):Play()
        end)

        b.MouseLeave:Connect(function()
            tween(b,{BackgroundColor3=Color3.fromRGB(20,20,26)},.15):Play()
        end)

        b.MouseButton1Click:Connect(callback)
    end

    -- encryption function
    local function encryptResponse(seedVal, challengeVal)
        return (seedVal * 7 + challengeVal * 13) % 999999
    end

    -- verify handshake
    local function verify()
        local storedSeed = lastCar:GetAttribute("KeySeed")
        local storedChallenge = lastCar:GetAttribute("Challenge")
        return encryptResponse(storedSeed, storedChallenge)
    end

    -------------------------------------------------
    -- ACTION: UNLOCK (ENCRYPTED)
    -------------------------------------------------
    makeAction("Unlock (Encrypted)",1,function()
        local expected = verify()
        local response = encryptResponse(seed, challenge)

        if response ~= expected then
            setText("ENCRYPTED KEY FOB\n\nHandshake Failed.\nRolling code mismatch.")
            status.Text = "Status: Denied"
            return
        end

        for _, d in ipairs(lastCar:GetDescendants()) do
            if d:IsA("BasePart") then
                pcall(function() d:SetAttribute("Locked", false) end)
            end
        end

        lastCar:SetAttribute("KeySeed", seed + math.random(5,25))

        setText("ENCRYPTED KEY FOB\n\nDoors Unlocked.\nHandshake Verified.")
        status.Text = "Status: Unlocked"
    end)

    -------------------------------------------------
    -- ACTION: LOCK (ENCRYPTED)
    -------------------------------------------------
    makeAction("Lock (Encrypted)",2,function()
        local expected = verify()
        local response = encryptResponse(seed, challenge)

        if response ~= expected then
            setText("ENCRYPTED KEY FOB\n\nHandshake Failed.\nRolling code mismatch.")
            status.Text = "Status: Denied"
            return
        end

        for _, d in ipairs(lastCar:GetDescendants()) do
            if d:IsA("BasePart") then
                pcall(function() d:SetAttribute("Locked", true) end)
            end
        end

        lastCar:SetAttribute("KeySeed", seed + math.random(5,25))

        setText("ENCRYPTED KEY FOB\n\nDoors Locked.\nHandshake Verified.")
        status.Text = "Status: Locked"
    end)

    -------------------------------------------------
    -- ACTION: REPLAY ATTACK
    -------------------------------------------------
    makeAction("Replay Attack",3,function()
        local storedSeed = lastCar:GetAttribute("KeySeed")
        local storedChallenge = lastCar:GetAttribute("Challenge")

        local fakeResponse = encryptResponse(storedSeed, storedChallenge)

        if fakeResponse == encryptResponse(seed, challenge) then
            setText("ENCRYPTED KEY FOB\n\nReplay Attack Failed.\nRolling code already changed.")
            status.Text = "Status: Replay Blocked"
        else
            setText("ENCRYPTED KEY FOB\n\nReplay Attack Blocked.\nVehicle rejected old code.")
            status.Text = "Status: Blocked"
        end
    end)

    -------------------------------------------------
    -- ACTION: FORCE SYNC
    -------------------------------------------------
