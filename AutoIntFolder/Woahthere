-----------------------------------------------------
-- ECU OVERRIDE (SPECTRE SIMULATION)
-----------------------------------------------------
local function ECU()
    moduleTransition(function()
        local lastCar = _G.AUTELPRO_SPECTRE.lastCar()
        if not lastCar or not lastCar.Parent then
            setText("<b>ECU OVERRIDE SUITE</b>\n\nNo target selected.\nAcquire a vehicle first.")
            status.Text = "Status: Idle"
            return
        end

        status.Text = "Status: ECU // NEGOTIATION"

        -----------------------------------------------------
        -- PHASE 1: CAN-BUS HANDSHAKE (SIMULATED)
        -----------------------------------------------------
        setText(("<b>ECU OVERRIDE SUITE</b>\n\nVehicle: %s\n\nInitiating CAN handshake...")
            :format(lastCar.Name))
        task.wait(.35)

        setText("<b>ECU OVERRIDE SUITE</b>\n\nAuthenticating with BCM...\nRolling code sync in progress...")
        task.wait(.45)

        -----------------------------------------------------
        -- PHASE 2: FRAME INJECTION (SIMULATED)
        -----------------------------------------------------
        setText("<b>ECU OVERRIDE SUITE</b>\n\nInjecting override frames...\n0x1A2 → 0x3F1")
        task.wait(.4)

        -----------------------------------------------------
        -- PHASE 3: ECU RESPONSE (SIMULATED)
        -----------------------------------------------------
        setText("<b>ECU OVERRIDE SUITE</b>\n\nAwaiting ECU response...\nMonitoring bus traffic...")
        task.wait(.5)

        -----------------------------------------------------
        -- PHASE 4: CLIENT-SIDE FLAG CLEAR (REAL)
        -----------------------------------------------------
        for _, d in ipairs(lastCar:GetDescendants()) do

            -- Engine / immobilizer flags
            if d:GetAttribute("EngineDisabled") ~= nil then
                d:SetAttribute("EngineDisabled", false)
            end

            if d:GetAttribute("Immobilized") ~= nil then
                d:SetAttribute("Immobilized", false)
            end

            -- SeatDisabled flag
            if d:GetAttribute("SeatDisabled") ~= nil then
                d:SetAttribute("SeatDisabled", false)
            end
        end

        -----------------------------------------------------
        -- PHASE 4B: SPECTRE SEAT-ATTACH STABILIZER
        -----------------------------------------------------
        local hum = game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        local seat = lastCar:FindFirstChildWhichIsA("VehicleSeat", true)

        if hum and seat then
            -- Force Roblox to rebuild the weld cleanly
            hum.Sit = false
            task.wait()

            -- Ensure seat attributes cannot block sit
            if seat:GetAttribute("SeatDisabled") ~= nil then
                seat:SetAttribute("SeatDisabled", false)
            end

            -- Re-enable sit
            hum.Sit = true
            task.wait(.1)

            -- Final failsafe: force seated state if weld didn't form
            if hum.SeatPart ~= seat then
                hum:ChangeState(Enum.HumanoidStateType.Seated)
                hum.Sit = true
            end
        end

        -----------------------------------------------------
        -- PHASE 5: BREACH CONFIRMATION (SPECTRE PULSE)
        -----------------------------------------------------
        progressLabel.Text = "<font color='rgb(255,60,60)'>▂▂▂▂▂▂▂▂▂▂</font>"

        setText(("<b>ECU OVERRIDE SUITE</b>\n\nVehicle: %s\n\n<font color='rgb(0,255,0)'>BREACH COMPLETE</font>")
            :format(lastCar.Name))

        status.Text = "Status: ECU // COMPLETE"
    end)
end

