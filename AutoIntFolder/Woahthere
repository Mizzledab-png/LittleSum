local open = false

local function toggle()
    clearSonarUI()
    clearPanelButtons()
    open = not open

    if open then
        tab.Visible = true
        tab.Size = UDim2.new(0,0,0,0)
        tween(tab,{Size=CFG.Size,BackgroundTransparency=0},.25):Play()
        status.Text = "Status: Idle"

        if lastCar and lastCar.Parent then
            setText(("CONNECTION LOCKED\n\n%s\n\n<font size='18'>Connection Progress:</font>"):format(lastCar.Name))
            showTargetUI(lastCar)
        else
            setText("Select a module on the left.")
        end
    else
        tween(tab,{Size=UDim2.new(0,0,0,0),BackgroundTransparency=1},.25):Play()
        task.delay(.26,function()
            if not open then tab.Visible = false end
        end)
        status.Text = "Status: Idle"
    end
end

uis.InputBegan:Connect(function(i,g)
    if not g and i.KeyCode == CFG.Key then toggle() end
end)

plr.Chatted:Connect(function(m)
    if m:lower() == CFG.Cmd then toggle() end
end)

