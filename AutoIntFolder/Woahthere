local function SPOOFKEY()
    clearSonarUI()

    if not lastCar or not lastCar.Parent then
        setText("SPOOF KEY MODE\n\nNo target selected.\nUse Connections first.")
        status.Text = "Status: Idle"
        return
    end

    local p = VM.primary[lastCar]
    if not p then
        setText("SPOOF KEY MODE\n\nVehicle missing primary part.")
        return
    end

    local ok, r = pcall(root)
    if not ok or not r or not r.Parent then return end

    local dist = (p.Position - r.Position).Magnitude
    if dist > 120 then
        setText("SPOOF KEY MODE\n\nOut of range.\nMove closer to the vehicle.")
        status.Text = "Status: Out of range"
        return
    end

    setText(("SPOOF KEY MODE\n\nVehicle: %s\nRange OK (%d studs)\n\nSelect an action:")
        :format(lastCar.Name, math.floor(dist)))
    status.Text = "Status: Key Fob Ready"

    local function makeAction(name, order, callback)
        local b = Instance.new("TextButton", panel)
        b.Size = UDim2.new(1,-16,0,30)
        b.Position = UDim2.new(0,8,0,180 + (order * 34))
        b.BackgroundColor3 = Color3.fromRGB(20,20,26)
        b.Font = Enum.Font.GothamBold
        b.TextColor3 = Color3.fromRGB(240,240,245)
        b.TextScaled = true
        b.Text = name
        Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)

        b.MouseEnter:Connect(function()
            tween(b, {BackgroundColor3 = CFG.Col}, .15):Play()
        end)

        b.MouseLeave:Connect(function()
            tween(b, {BackgroundColor3 = Color3.fromRGB(20,20,26)}, .15):Play()
        end)

        b.MouseButton1Click:Connect(callback)
    end

    -- Lock Doors
    makeAction("Lock Doors",1,function()
        for _, d in ipairs(lastCar:GetDescendants()) do
            if d:IsA("BasePart") then
                pcall(function()
                    d:SetAttribute("Locked", true)
                end)
            end
        end

        setText("SPOOF KEY MODE\n\nDoors Locked.\nLights flashed.")
        status.Text = "Status: Locked"

        for _, l in ipairs(lastCar:GetDescendants()) do
            if l:IsA("Light") then
                pcall(function()
                    l.Enabled = true
                    task.delay(.25,function()
                        l.Enabled = false
                    end)
                end)
            end
        end
    end)

    -- Unlock Doors
    makeAction("Unlock Doors",2,function()
        for _, d in ipairs(lastCar:GetDescendants()) do
            if d:IsA("BasePart") then
                pcall(function()
                    d:SetAttribute("Locked", false)
                end)
            end
        end

        setText("SPOOF KEY MODE\n\nDoors Unlocked.")
        status.Text = "Status: Unlocked"
    end)

    -- Honk Horn
    makeAction("Honk Horn",3,function()
        for _, s in ipairs(lastCar:GetDescendants()) do
            if s:IsA("Sound") and s.Name:lower():find("horn") then
                pcall(function()
                    s:Play()
                end)
            end
        end

        setText("SPOOF KEY MODE\n\nHorn Activated.")
        status.Text = "Status: Horn"
    end)

    -- Flash Lights
    makeAction("Flash Lights",4,function()
        for _, l in ipairs(lastCar:GetDescendants()) do
            if l:IsA("Light") then
                pcall(function()
                    l.Enabled = true
                    task.delay(.3,function()
                        l.Enabled = false)
                    end)
                end)
            end
        end

        setText("SPOOF KEY MODE\n\nLights Flashed.")
        status.Text = "Status: Flash"
    end)

    -- Panic Mode
    makeAction("Panic Mode",5,function()
        setText("SPOOF KEY MODE\n\nPanic Mode Activated!")
        status.Text = "Status: PANIC"

        local t = 0
        local panicConn
        panicConn = rs.Heartbeat:Connect(function(dt)
            t += dt
            if t > 3 then
                panicConn:Disconnect()
                status.Text = "Status: Idle"
                return
            end

            for _, l in ipairs(lastCar:GetDescendants()) do
                if l:IsA("Light") then
                    pcall(function()
                        l.Enabled = (math.random() > .5)
                    end)
                end
            end

            for _, s in ipairs(lastCar:GetDescendants()) do
                if s:IsA("Sound") and s.Name:lower():find("horn") then
                    if math.random() > .8 then
                        pcall(function()
                            s:Play()
                        end)
                    end
                end
            end
        end)
    end)
end
