local isFull = false

local function expandToFull()
    if isFull then return end
    isFull = true

    full.Visible = true
    spectralFlicker(full)

    -- fade in full-screen
    tween(full, {BackgroundTransparency = 0.05}, CFG.FadeTime):Play()
    tween(tab, {BackgroundTransparency = 1}, CFG.FadeTime):Play()

    task.delay(CFG.FadeTime, function()
        tab.Visible = false
