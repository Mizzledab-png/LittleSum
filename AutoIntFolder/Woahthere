--========================================================--
-- VEHICLE DETECTION
--========================================================--

local vehicleSeats = {}
local carRegistered = {}
local attributesInitialized = {}

local function getTopmostModelFromSeat(seat)
    local current = seat
    local topModel = nil
    while current and current.Parent do
        if current:IsA("Model") then
            topModel = current
        end
        if current.Parent == workspace then break end
        current = current.Parent
    end
    return topModel
end

local function registerCar(seat)
    if not seat:IsA("VehicleSeat") then return end
    local car = getTopmostModelFromSeat(seat)
    if car and not carRegistered[car] then
        carRegistered[car] = true
        table.insert(vehicleSeats, seat)
    end
end

for _, obj in ipairs(workspace:GetDescendants()) do
    if obj:IsA("VehicleSeat") then
        registerCar(obj)
    end
end

workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("VehicleSeat") then
        registerCar(obj)
    end
end)

workspace.DescendantRemoving:Connect(function(obj)
    if obj:IsA("Model") and carRegistered[obj] then
        carRegistered[obj] = nil
        attributesInitialized[obj] = nil
        for i = #vehicleSeats, 1, -1 do
            local seat = vehicleSeats[i]
            if not seat.Parent or getTopmostModelFromSeat(seat) == obj then
                table.remove(vehicleSeats, i)
            end
        end
    end
end)

local function ensureCarAttributes(car)
    if attributesInitialized[car] then return end
    attributesInitialized[car] = true

    if not car:GetAttribute("KeyCode") then
        car:SetAttribute("KeyCode", tostring(math.random(100000, 999999)))
    end
    if car:GetAttribute("Locked") == nil then
        car:SetAttribute("Locked", true)
    end
end

local function findCar(opts)
    opts = opts or {}
    local useForward = opts.useForward or false
    local maxDist = opts.maxDist or math.huge
    local minDot = opts.minDot or 0

    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local cam = workspace.CurrentCamera
    local forward = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)

    local bestCar, bestDist = nil, maxDist

    for _, seat in ipairs(vehicleSeats) do
        if seat.Parent then
            local car = getTopmostModelFromSeat(seat)
            if car then
                local primary = car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart", true)
                if primary then
                    local offset = primary.Position - root.Position
                    local dist = offset.Magnitude
                    if dist <= bestDist then
                        if useForward then
                            local dir = offset.Unit
                            if forward:Dot(dir) >= minDot then
                                bestCar, bestDist = car, dist
                            end
                        else
                            bestCar, bestDist = car, dist
                        end
                    end
                end
            end
        end
    end

    return bestCar
end

--========================================================--
-- SONAR UI
--========================================================--

local activeDistanceUIs = {}

local function clearAllSonarUI()
    for car, entry in pairs(activeDistanceUIs) do
        if entry.gui then
            entry.gui:Destroy()
        end
        activeDistanceUIs[car] = nil
    end
end

local function createDistanceUI(car)
    if activeDistanceUIs[car] then return end

    local primary = car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart", true)
    if not primary then return end

    if car:FindFirstChild("AutelDistanceUI") then
        car.AutelDistanceUI:Destroy()
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "AutelDistanceUI"
    billboard.Size = UDim2.new(0, 120, 0, 40)
    billboard.Adornee = primary
    billboard.AlwaysOnTop = true
    billboard.StudsOffset = Vector3.new(0, 4, 0)
    billboard.Parent = car

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 0, 0)
    label.TextScaled = true
    label.Font = Enum.Font.SourceSansBold
    label.Text = "Distance: ???"
    label.Parent = billboard

    activeDistanceUIs[car] = {
        gui = billboard,
        label = label,
        primary = primary,
    }
end

RunService.Heartbeat:Connect(function()
    if currentMode ~= "SONAR" then return end
    if next(activeDistanceUIs) == nil then return end

    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        clearAllSonarUI()
        return
    end

    for car, entry in pairs(activeDistanceUIs) do
        local primary = entry.primary
        if not car.Parent or not primary or not primary.Parent then
            if entry.gui then
                entry.gui:Destroy()
            end
            activeDistanceUIs[car] = nil
        else
            local dist = (primary.Position - root.Position).Magnitude
            entry.label.Text = "Distance: " .. math.floor(dist) .. " studs"
        end
    end
end)

--========================================================--
-- SPOOF
--========================================================--

local spoofedKeys = {}
local lastScannedCar = nil

local function spoofKey(car)
    local code = car:GetAttribute("KeyCode")
    if not code then
        syncStatus("Car has no key", Color3.fromRGB(255, 0, 0))
        return
    end

    spoofedKeys[code] = true
    isLinked = true
    updateLinkStatus()

    car:SetAttribute("Locked", false)

    for _, d in ipairs(car:GetDescendants()) do
        if d:IsA("VehicleSeat") or d:IsA("Seat") then
            d.Disabled = false
        end
        if d:IsA("BasePart") then
            d.Anchored = false
        end
        if d:GetAttribute("EngineDisabled") ~= nil then
            d:SetAttribute("EngineDisabled", false)
        end
        if d:GetAttribute("Immobilized") ~= nil then
            d:SetAttribute("Immobilized", false)
        end
        if d:IsA("Script") or d:IsA("LocalScript") then
            local n = d.Name:lower()
            if n:find("lock") or n:find("immobil") or n:find("engine") then
                d.Disabled = true
            end
        end
    end

    syncStatus("Spoofed: " .. car.Name, Color3.fromRGB(0, 255, 0))
    syncMain("SPOOF MODULE\n\nVehicle: " .. car.Name .. "\nKey spoofed and locks bypassed.")
end

--========================================================--
-- NAVIGATION LOGIC
--========================================================--

-- 360° SCAN detection
scanNav.MouseButton1Click:Connect(function()
    isLinked = false
    updateLinkStatus()
    clearAllSonarUI()
    highlightNav("SCAN")

    local car = findCar({
        useForward = false, -- 360° detection
        maxDist = 60,
    })

    if not car then
        syncStatus("No car found", Color3.fromRGB(255, 0, 0))
        syncMain("SCAN MODULE\n\nNo vehicle detected around you.")
        return
    end

    ensureCarAttributes(car)
    lastScannedCar = car

    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local primary = car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart", true)
    local dist = (root and primary) and (primary.Position - root.Position).Magnitude or 0
    local locked = car:GetAttribute("Locked")

    syncStatus("Target acquired: " .. car.Name, Color3.fromRGB(0, 255, 0))
    syncMain(string.format(
        "SCAN MODULE\n\nNearest Vehicle (360°):\nName: %s\nDistance: %d studs\nLocked: %s",
        car.Name,
        math.floor(dist),
        tostring(locked)
    ))
end)

spoofNav.MouseButton1Click:Connect(function()
    isLinked = false
    updateLinkStatus()
    clearAllSonarUI()
    highlightNav("SPOOF")

    if not lastScannedCar then
        syncStatus("Scan a car first", Color3.fromRGB(255, 170, 0))
        syncMain("SPOOF MODULE\n\nNo vehicle selected.\nRun SCAN first.")
        return
    end

    ensureCarAttributes(lastScannedCar)
    spoofKey(lastScannedCar)
end)

-- Full multi-car SONAR labels
sonarNav.MouseButton1Click:Connect(function()
    isLinked = false
    updateLinkStatus()
    clearAllSonarUI()
    highlightNav("SONAR")

    if #vehicleSeats == 0 then
        syncStatus("No cars found", Color3.fromRGB(255, 0, 0))
        syncMain("SONAR MODULE\n\nNo vehicles detected in the world.")
        return
    end

    local seenCars = {}
    for _, seat in ipairs(vehicleSeats) do
        if seat.Parent then
            local car = getTopmostModelFromSeat(seat)
            if car and not seenCars[car] then
                seenCars[car] = true
                createDistanceUI(car)
            end
        end
    end

    if next(seenCars) == nil then
        syncStatus("No cars detected", Color3.fromRGB(255, 0, 0))
        syncMain("SONAR MODULE\n\nNo vehicles in range.")
        return
    end

    syncStatus("SONAR tracking all vehicles", Color3.fromRGB(0, 255, 0))
    syncMain("SONAR MODULE\n\nTracking ALL vehicles.\nDistance labels stay above each car while SONAR is active.")
end)

setNav.MouseButton1Click:Connect(function()
    isLinked = false
