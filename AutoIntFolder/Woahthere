-- VEHICLE MANAGER
-----------------------------
local function getTopmostModelFromSeat(seat)
    local cur,top = seat,nil
    while cur and cur.Parent do
        if cur:IsA("Model") then top = cur end
        if cur.Parent == workspace then break end
        cur = cur.Parent
    end
    return top
end

local VehicleManager = {}
VehicleManager.__index = VehicleManager

function VehicleManager.new()
    local self = setmetatable({
        vehicleSeats = {},
        carRegistered = {},
        attributesInitialized = {}
    }, VehicleManager)

    self:_scanExisting()
    self:_hookWorkspace()
    return self
end

function VehicleManager:_scanExisting()
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("VehicleSeat") then
            self:_registerSeat(obj)
        end
    end
end

function VehicleManager:_hookWorkspace()
    workspace.DescendantAdded:Connect(function(obj)
        if obj:IsA("VehicleSeat") then
            self:_registerSeat(obj)
        end
    end)

    workspace.DescendantRemoving:Connect(function(obj)
        if obj:IsA("Model") and self.carRegistered[obj] then
            self.carRegistered[obj] = nil
            self.attributesInitialized[obj] = nil

            for i=#self.vehicleSeats,1,-1 do
                local seat = self.vehicleSeats[i]
                if not seat.Parent or getTopmostModelFromSeat(seat) == obj then
                    table.remove(self.vehicleSeats,i)
                end
            end
        end
    end)
end

function VehicleManager:_registerSeat(seat)
    local car = getTopmostModelFromSeat(seat)
    if car and not self.carRegistered[car] then
        self.carRegistered[car] = true
        table.insert(self.vehicleSeats, seat)
    end
end

function VehicleManager:ensureAttributes(car)
    if self.attributesInitialized[car] then return end
    self.attributesInitialized[car] = true

    if not car:GetAttribute("KeyCode") then
        car:SetAttribute("KeyCode", tostring(math.random(100000,999999)))
    end
    if car:GetAttribute("Locked") == nil then
        car:SetAttribute("Locked", true)
    end
end

function VehicleManager:getCarList()
    local list = {}
    for car in pairs(self.carRegistered) do
        if car and car.Parent then
            table.insert(list,car)
        end
    end
    return list
end

