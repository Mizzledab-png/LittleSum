local function buildVehicleList()
    local list = {}
    local char = plr.Character or plr.CharacterAdded:Wait()
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return list end

    local rootPos = root.Position

    for seat,info in pairs(VehicleDB) do
        if seat.Parent and info.car and info.car.Parent then
            local pos
            if info.car:IsA("Model") and info.car.PrimaryPart then
                pos = info.car.PrimaryPart.Position
            else
                pos = seat.Position
            end

            table.insert(list,{
                car = info.car,
                seat = seat,
                dist = (pos - rootPos).Magnitude
            })
        else
            VehicleDB[seat] = nil
        end
    end

    table.sort(list,function(a,b) return a.dist < b.dist end)
    return list
end

