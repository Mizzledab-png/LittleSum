local SonarManager = {}
SonarManager.__index = SonarManager

function SonarManager.new()
    return setmetatable({cleaner=UICleaner.new()},SonarManager)
end

function SonarManager:clearAll()
    self.cleaner:clear()
end

function SonarManager:createDistanceUI(car)
    local primary = getPrimary(car)
    if not primary then return end

    local old = car:FindFirstChild("AutelDistanceUI")
    if old then old:Destroy() end

    local gui = Instance.new("BillboardGui")
    gui.Name = "AutelDistanceUI"
    gui.Size = UDim2.new(0,80,0,28) -- PATCHED (smaller UI)
    gui.Adornee = primary
    gui.AlwaysOnTop = true
    gui.StudsOffset = Vector3.new(0,4,0)
    gui.Parent = car

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1,0,1,0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255,0,0)
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 14 -- PATCHED (smaller text)
    label.Text = "Distance: ???"
    label.Parent = gui

    self.cleaner:add(gui)
end

function SonarManager:update()
    if not Mode:is("SONAR") then return end

    local root = getRoot()
    if not root then
        self:clearAll()
        return
    end

    for _,gui in ipairs(self.cleaner.items) do
        local car = gui.Parent
        local primary = getPrimary(car)
        if primary then
            local label = gui:FindFirstChildWhichIsA("TextLabel")
            if label then
                local dist = (primary.Position - root.Position).Magnitude
                label.Text = "Distance: "..math.floor(dist).." studs"
            end
        end
    end
end


-----------------------------
-- SPOOF LOGIC
-----------------------------
local spoofedKeys    = {}
local lastScannedCar = nil

local function spoofKey(car)
    if not car or not car.Parent then
        syncStatus("Vehicle invalid", CONFIG.Theme.StatusBad)
        return
    end

    local code = car:GetAttribute("KeyCode")
    if not code then
        syncStatus("Car has no key", CONFIG.Theme.StatusBad)
        return
    end

    spoofedKeys[code] = true
    isLinked = true
    updateLinkStatus()

    car:SetAttribute("Locked", false)

    for _,d in ipairs(car:GetDescendants()) do
        if d:IsA("VehicleSeat") or d:IsA("Seat") then
            d.Disabled = false
        end

        if d:IsA("BasePart") then
            d.Anchored = false
        end

        if d:GetAttribute("EngineDisabled") ~= nil then
            d:SetAttribute("EngineDisabled", false)
        end

        if d:GetAttribute("Immobilized") ~= nil then
            d:SetAttribute("Immobilized", false)
        end

        if d:IsA("Script") or d:IsA("LocalScript") then
            local n = d.Name:lower()
            if n:find("lock") or n:find("immobil") or n:find("engine") then
                d.Disabled = true
            end
        end
    end

    syncStatus("Spoofed: "..car.Name, CONFIG.Theme.StatusGood)
    syncMain(
        "SPOOF MODULE\n\n"..
        "Vehicle: "..car.Name..
        "\nKey spoofed and locks bypassed.\n\n"..
        "Engine and immobilizer scripts neutralized."
    )
end

