    CompactPos  = UDim2.new(.5,0,.55,0),

    FullSize    = UDim2.new(1,0,1,0),
    FullPos     = UDim2.new(0,0,0,0),

    Key = Enum.KeyCode.T,
    Cmd = "!autel",

    Col = Color3.fromRGB(220,40,40), -- spectral red
    BG_Compact = Color3.fromRGB(5,5,8),
    BG_Full    = Color3.fromRGB(0,0,0),

    FadeTime = .25,
    FlickerTime = .15,
}

-- Tween helper
local function tween(o,p,t)
    return ts:Create(o, TweenInfo.new(t or .25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), p)
end

-- Spectral flicker (SPECTRE signature)
local function spectralFlicker(obj)
    obj.BackgroundTransparency = 1
    tween(obj,{BackgroundTransparency=.4},CFG.FlickerTime):Play()
    task.wait(CFG.FlickerTime)
    tween(obj,{BackgroundTransparency=0},CFG.FlickerTime):Play()
end

-- Progress bar (red spectral)
local function getProgressBar(pct)
    local filled = math.floor(pct/10)
    local empty = 10 - filled
    local bar = ""

    for _ = 1,filled do
        bar = bar .. "<font color='rgb(220,40,40)'>▂</font>"
    end
    for _ = 1,empty do
        bar = bar .. "<font color='rgb(60,60,60)'>▂</font>"
    end

    return bar
end

-- Root helper
local function root()
    local c = plr.Character or plr.CharacterAdded:Wait()
    return c:WaitForChild("HumanoidRootPart")
end
