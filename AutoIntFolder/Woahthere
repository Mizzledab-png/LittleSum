    end)
end

uis.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == CFG.Key then
        if tab.Visible then
            closeTablet()
        else
            openTablet()
        end
    end
end)

plr.Chatted:Connect(function(msg)
    msg = msg:lower()
    if msg == CFG.Cmd then
        if tab.Visible then
            closeTablet()
        else
            openTablet()
        end
    end
end)
