    b.BackgroundColor3 = Color3.fromRGB(15,15,22)
    b.Font = Enum.Font.GothamBold
    b.TextScaled = true
    b.TextColor3 = Color3.fromRGB(240,240,245)
    b.Text = label
    b.ZIndex = 4
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)

    b.MouseEnter:Connect(function()
        tween(b,{BackgroundColor3 = CFG.Col},0.15):Play()
    end)
    b.MouseLeave:Connect(function()
        tween(b,{BackgroundColor3 = Color3.fromRGB(15,15,22)},0.15):Play()
    end)

    b.MouseButton1Click:Connect(callback)
end

local function BUILD_BUTTON_PANEL()
    makeMainButton("ACQUIRE",1,ACQUIRE)
    makeMainButton("ECU",2,ECU)
    makeMainButton("KEY",3,KEY)
    makeMainButton("SCAN",4,SCAN)
    makeMainButton("EXIT",5,EXIT)
end

-- INPUT ROUTING
uis.InputBegan:Connect(function(i)
    if i.KeyCode == CFG.Key then
        if not isFull() then
            expandToFull()
            setText("<b>AUTEL//PRO SPECTRE</b>\n\nSelect a module.")
            status.Text = "Status: READY"
            BUILD_BUTTON_PANEL()
        else
            EXIT()
        end
    end
end)

plr.Chatted:Connect(function(msg)
    msg = msg:lower()

    if msg == CFG.Cmd then
        if not isFull() then
            expandToFull()
            setText("<b>AUTEL//PRO SPECTRE</b>\n\nSelect a module.")
            status.Text = "Status: READY"
            BUILD_BUTTON_PANEL()
        else
            EXIT()
        end
    end

    if msg == "!acq" then ACQUIRE() end
    if msg == "!ecu" then ECU() end
    if msg == "!key" then KEY() end
    if msg == "!scan" then SCAN() end
    if msg == "!exit" then EXIT() end
end)
