    moduleTransition(function()
        status.Text = "Status: SCAN // ACTIVE"
        setText("<b>TACTICAL SCAN SUITE</b>\n\nInitializing spectral sweep...")

        radarPulse()

        local list = buildVehicleList()
        if #list == 0 then
            setText("<b>TACTICAL SCAN SUITE</b>\n\nNo vehicle signatures detected.\nAO remains cold.")
            return
        end

        setText("<b>TACTICAL SCAN SUITE</b>\n\nTargets detected:\n")

        -----------------------------------------------------
        -- SCAN READOUT
        -----------------------------------------------------
        local y = 260
        for _, entry in ipairs(list) do
            local car = entry.car
            local dist = math.floor(entry.dist)

            local line = Instance.new("TextLabel", panel)
            line.Size = UDim2.new(1, -20, 0, 30)
            line.Position = UDim2.new(0, 10, 0, y)
            line.BackgroundTransparency = 1
            line.Font = Enum.Font.Gotham
            line.TextScaled = true
            line.RichText = true
            line.TextColor3 = Color3.fromRGB(240, 240, 245)
            line.TextXAlignment = Enum.TextXAlignment.Left

            line.Text = string.format(
                "<b>%s</b>  —  <font color='rgb(220,40,40)'>%d studs</font>",
                car.Name,
                dist
            )

            y += 34
        end

        status.Text = "Status: SCAN // COMPLETE"
    end)
end

-- Expose module
_G.AUTELPRO_SPECTRE.SCAN = SCAN
