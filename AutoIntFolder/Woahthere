-- SECTION 4: CORE MODULES / HELPERS
-------------------------------------

local activeBillboard = nil
local liveUpdater = nil
local listUpdater = nil
local progressUpdater = nil

local function disconnectConn(c)
    if c then c:Disconnect() end
end

local function clearSonarUI()
    sonarList.Visible = false
    sonarList.CanvasSize = UDim2.new(0,0,0,0)

    for _,v in ipairs(sonarList:GetChildren()) do
        if v:IsA("TextButton") then
            v:Destroy()
        end
    end

    if activeBillboard then
        activeBillboard:Destroy()
        activeBillboard = nil
    end

    disconnectConn(liveUpdater)
    disconnectConn(listUpdater)
    disconnectConn(progressUpdater)

    liveUpdater = nil
    listUpdater = nil
    progressUpdater = nil

    progressLabel.Text = ""
end

local function clearPanel()
    setText(" ")
    progressLabel.Text = ""

    for _,v in ipairs(panel:GetChildren()) do
        if v:IsA("TextButton") then
            v:Destroy()
        end
    end

    clearSonarUI()
end

local function moduleTransition(callback)
    tween(panel, {BackgroundTransparency = 1}, .15):Play()
    tween(txt, {TextTransparency = 1}, .15):Play()
    tween(progressLabel, {TextTransparency = 1}, .15):Play()

    task.wait(.16)

    clearPanel()
    callback()

    tween(panel, {BackgroundTransparency = 0}, .15):Play()
    tween(txt, {TextTransparency = 0}, .15):Play()
    tween(progressLabel, {TextTransparency = 0}, .15):Play()
end

local function showTargetUI(car)
    if activeBillboard then activeBillboard:Destroy() end
    disconnectConn(liveUpdater)
    disconnectConn(progressUpdater)
    progressLabel.Text = ""

    local p = VM.primary[car]
    if not p then return end

    local pct = 0
    progressUpdater = rs.Heartbeat:Connect(function()
        if pct < 100 then
            pct = math.min(pct + 2, 100)
            progressLabel.Text = getProgressBar(pct)
        else
            progressLabel.Text = "<font color='rgb(0,255,0)'>BREACH COMPLETE</font>"
            disconnectConn(progressUpdater)
            progressUpdater = nil

            local bb = Instance.new("BillboardGui")
            bb.Size = UDim2.new(0,150,0,45)
            bb.AlwaysOnTop = true
            bb.Adornee = p
            bb.Parent = car
            activeBillboard = bb

            local lb = Instance.new("TextLabel", bb)
            lb.Size = UDim2.new(1,0,1,0)
            lb.BackgroundTransparency = 1
            lb.Font = Enum.Font.GothamBold
            lb.TextScaled = true
            lb.TextColor3 = Color3.fromRGB(255,60,60)

            liveUpdater = rs.Heartbeat:Connect(function()
                if not car.Parent then
                    lb.Text = "TARGET LOST"
                    return
                end

                local ok, r = pcall(root)
                if not ok or not r or not r.Parent then
                    lb.Text = car.Name .. "\nN/A"
                    return
                end

                local d = math.floor((p.Position - r.Position).Magnitude)
                lb.Text = ("%s\n%d studs"):format(car.Name, d)
            end)
        end
    end)
end

local function buildVehicleList()
    local ok, r = pcall(root)
    if not ok or not r or not r.Parent then return {} end

    local list = {}
    for _,m in ipairs(VM.cars) do
        local p = VM.primary[m]
        if p and m.Parent then
            local d = (p.Position - r.Position).Magnitude
            table.insert(list, {car = m, dist = d})
        end
    end

    table.sort(list, function(a,b)
        return a.dist < b.dist
    end)

    return list
end

-------------------------------------------------
-- CONNECTIONS MODULE (VEHICLE ACQUISITION)
-------------------------------------------------

local function CONNECTIONS()
    moduleTransition(function()
        status.Text = "Status: Acquisition"

        local list = buildVehicleList()
        if #list == 0 then
            setText("<b>VEHICLE ACQUISITION MODE</b>\n\nNo targets detected in AO.")
            return
        end

        setText("<b>VEHICLE ACQUISITION MODE</b>\n\nSelect target from list below.")
        sonarList.Visible = true

        local buttons = {}

        for _,e in ipairs(list) do
            local b = Instance.new("TextButton", sonarList)
            b.Size = UDim2.new(1,0,0,22)
            b.BackgroundTransparency = 1
            b.TextColor3 = Color3.new(1,1,1)
            b.Font = Enum.Font.Gotham
            b.TextSize = 14
            b.RichText = true
            b.TextXAlignment = Enum.TextXAlignment.Left

            b.Text = string.format("%s  %s  (%d studs)",
                e.car.Name,
                getSignalBars(e.dist),
                math.floor(e.dist)
            )

            buttons[e.car] = b

            b.MouseButton1Click:Connect(function()
                lastCar = e.car
                clearSonarUI()
                setText(("<b>TARGET LOCKED</b>\n\n%s\n\nReprogram sequence ready.")
                    :format(e.car.Name))
                status.Text = "Status: Target Locked"
                showTargetUI(e.car)
            end)
        end

        sonarList.CanvasSize = UDim2.new(0,0,0,#list * 26)

        disconnectConn(listUpdater)
        listUpdater = rs.Heartbeat:Connect(function()
            local ok, r = pcall(root)
            if not ok or not r or not r.Parent then return end

            for car,button in pairs(buttons) do
                if car and car.Parent then
                    local p = VM.primary[car]
                    if p then
                        local d = math.floor((p.Position - r.Position).Magnitude)
                        button.Text = string.format("%s  %s  (%d studs)",
                            car.Name,
                            getSignalBars(d),
                            d
                        )
                    end
                else
                    button.Text = (car and car.Name or "Unknown") .. " (lost)"
                end
            end
        end)
    end)
end

-------------------------------------------------
-- REPROGRAM MODULE (ECU OVERRIDE)
-------------------------------------------------

local function REPROGRAM()
    moduleTransition(function()
        disconnectConn(liveUpdater)
        disconnectConn(listUpdater)
        disconnectConn(progressUpdater)

        if not lastCar or not lastCar.Parent then
            setText("<b>ECU OVERRIDE MODULE</b>\n\nNo target selected.\nAcquire target first.")
            status.Text = "Status: Idle"
            return
        end

        setText(("<b>ECU OVERRIDE MODULE</b>\n\nVehicle: %s\n\nClearing client-side immobilizer flags...")
            :format(lastCar.Name))
        status.Text = "Status: Override"

        for _, d in ipairs(lastCar:GetDescendants()) do
            if d:GetAttribute("EngineDisabled") ~= nil then
                d:SetAttribute("EngineDisabled", false)
            end

            if d:GetAttribute("Immobilized") ~= nil then
                d:SetAttribute("Immobilized", false)
            end
        end

        progressLabel.Text = getProgressBar(100)
        setText(("<b>ECU OVERRIDE MODULE</b>\n\nVehicle: %s\n\n<font color='rgb(0,255,0)'>CLIENT OVERRIDE COMPLETE</font>")
            :format(lastCar.Name))
        status.Text = "Status: Override Complete"
    end)
end

-------------------------------------------------
-- SCAN MODULE (TACTICAL SCAN)
-------------------------------------------------

local function SCAN()
    moduleTransition(function()
        status.Text = "Status: Scanning"

        local list = buildVehicleList()
        if #list == 0 then
            setText("<b>TACTICAL SCAN</b>\n\nNo vehicles detected in AO.")
            status.Text = "Status: Scan complete (0)"
            return
        end

        local count = #list
        local nearest = list[1]
        local farthest = list[#list]

        local sum = 0
        for _,e in ipairs(list) do
            sum += e.dist
        end

        local avg = math.floor(sum / count)

        local text = string.format(
            "<b>TACTICAL SCAN</b>\n\nTargets detected: %d\n\nNearest: %s (%.0f studs)\nFarthest: %s (%.0f studs)\nAverage distance: %d studs",
            count,
            nearest.car.Name, nearest.dist,
            farthest.car.Name, farthest.dist,
            avg
        )

        setText(text)
        status.Text = "Status: Scan complete ("..count..")"
    end)
end

-------------------------------------
-- SECTION 5: SPOOF KEY MODULE (BLACK-OPS)
-------------------------------------

local function SPOOFKEY()
    moduleTransition(function()
        if not lastCar or not lastCar.Parent then
            setText("<b>KEYFOB SPOOF SUITE</b>\n\nNo target selected.\nAcquire target first.")
            status.Text = "Status: Idle"
            return
        end

        local p = VM.primary[lastCar]
        if not p then
            setText("<b>KEYFOB SPOOF SUITE</b>\n\nVehicle missing primary part.")
            return
        end

        local ok, r = pcall(root)
        if not ok or not r or not r.Parent then return end

        local dist = (p.Position - r.Position).Magnitude
        if dist > 120 then
            setText("<b>KEYFOB SPOOF SUITE</b>\n\nOut of range.\nClose distance to target.")
            status.Text = "Status: Out of range"
            return
        end

        setText(("<b>KEYFOB SPOOF SUITE</b>\n\nVehicle: %s\nRange OK (%d studs)\n\nSelect operation:")
            :format(lastCar.Name, math.floor(dist)))
        status.Text = "Status: Key Suite Ready"

        local function makeAction(name, order, callback)
            local b = Instance.new("TextButton", panel)
            b.Size = UDim2.new(1,-16,0,30)
            b.Position = UDim2.new(0,8,0,170 + (order * 34))
            b.BackgroundColor3 = Color3.fromRGB(15,15,22)
            b.Font = Enum.Font.GothamBold
            b.TextColor3 = Color3.fromRGB(240,240,245)
            b.TextScaled = true
            b.Text = name
            Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)

            b.MouseEnter:Connect(function()
                tween(b,{BackgroundColor3=CFG.Col},.15):Play()
            end)

            b.MouseLeave:Connect(function()
                tween(b,{BackgroundColor3=Color3.fromRGB(15,15,22)},.15):Play()
            end)

            b.MouseButton1Click:Connect(callback)
        end

        -------------------------------------------------
        -- ACTION: LOCK DOORS
        -------------------------------------------------
        makeAction("Lock Doors",1,function()
            setText("<b>KEYFOB SPOOF SUITE</b>\n\nTransmitting lock command...")
            status.Text = "Status: Locking"

            for _,d in ipairs(lastCar:GetDescendants()) do
                if d:IsA("BasePart") then
                    pcall(function()
                        d:SetAttribute("Locked", true)
                    end)
                end
            end

            task.wait(.3)
            setText("<b>KEYFOB SPOOF SUITE</b>\n\nDoors locked.\nVisual confirmation triggered.")
            status.Text = "Status: Locked"

            for _,l in ipairs(lastCar:GetDescendants()) do
                if l:IsA("Light") then
                    pcall(function()
                        l.Enabled = true
                        task.delay(.25,function()
                            l.Enabled = false
                        end)
                    end)
                end
            end
        end)

        -------------------------------------------------
        -- ACTION: UNLOCK DOORS (Simulated CAN Unlock)
        -------------------------------------------------
        makeAction("Unlock Doors",2,function()
            setText("<b>KEYFOB SPOOF SUITE</b>\n\nInitiating CAN handshake...")
            status.Text = "Status: CAN Negotiation"
            task.wait(.4)

            setText("<b>KEYFOB SPOOF SUITE</b>\n\nAuthenticating with BCM...\nRolling code exchange in progress...")
            task.wait(.6)

            setText("<b>KEYFOB SPOOF SUITE</b>\n\nInjecting unlock frame...\n0x1A2 → 0x3F1")
            task.wait(.5)

            setText("<b>KEYFOB SPOOF SUITE</b>\n\nActuator response pending...\nAwaiting confirmation...")
            task.wait(.5)

            for _,d in ipairs(lastCar:GetDescendants()) do
                if d:IsA("BasePart") then
                    pcall(function()
                        d:SetAttribute("Locked", false)
                    end)
                end
            end

            setText("<b>KEYFOB SPOOF SUITE</b>\n\n<font color='rgb(0,255,0)'>UNLOCK SUCCESS</font>\nCAN session terminated.")
            status.Text = "Status: Unlocked"

            for _,l in ipairs(lastCar:GetDescendants()) do
                if l:IsA("Light") then
                    pcall(function()
                        l.Enabled = true
                        task.delay(.25,function()
                            l.Enabled = false
                        end)
                    end)
                end
            end
        end)

        -------------------------------------------------
        -- ACTION: HONK HORN
        -------------------------------------------------
        makeAction("Honk Horn",3,function()
            setText("<b>KEYFOB SPOOF SUITE</b>\n\nTriggering horn actuator...")
            status.Text = "Status: Horn"

            for _,s in ipairs(lastCar:GetDescendants()) do
                if s:IsA("Sound") and s.Name:lower():find("horn") then
                    pcall(function()
                        s:Play()
                    end)
                end
            end

            task.wait(.3)
            setText("<b>KEYFOB SPOOF SUITE</b>\n\nHorn activation complete.")
        end)

        -------------------------------------------------
        -- ACTION: FLASH LIGHTS
        -------------------------------------------------
        makeAction("Flash Lights",4,function()
            setText("<b>KEYFOB SPOOF SUITE</b>\n\nFlashing external lighting...")
            status.Text = "Status: Flash"

            for _,l in ipairs(lastCar:GetDescendants()) do
                if l:IsA("Light") then
                    pcall(function()
                        l.Enabled = true
                        task.delay(.3,function()
                            l.Enabled = false
                        end)
                    end)
                end
            end

            task.wait(.3)
            setText("<b>KEYFOB SPOOF SUITE</b>\n\nFlash sequence complete.")
        end)

        -------------------------------------------------
        -- ACTION: PANIC MODE
        -------------------------------------------------
        makeAction("Panic Mode",5,function()
            setText("<b>KEYFOB SPOOF SUITE</b>\n\nPanic protocol engaged.")
            status.Text = "Status: PANIC"

            local t = 0
            local panicConn
            panicConn = rs.Heartbeat:Connect(function(dt)
                t += dt
                if t > 3 then
                    panicConn:Disconnect()
                    status.Text = "Status: Idle"
                    setText("<b>KEYFOB SPOOF SUITE</b>\n\nPanic protocol disengaged.")
                    return
                end

                for _,l in ipairs(lastCar:GetDescendants()) do
                    if l:IsA("Light") then
                        pcall(function()
                            l.Enabled = (math.random() > .5)
                        end)
                    end
                end

                for _,s in ipairs(lastCar:GetDescendants()) do
                    if s:IsA("Sound") and s.Name:lower():find("horn") then
                        if math.random() > .8 then
                            pcall(function()
                                s:Play()
                            end)
                        end
                    end
                end
            end)
        end)
    end)
end

