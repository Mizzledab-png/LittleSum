-----------------------------
-- MODE CONTROLLER
-----------------------------
local vehicleManager = VehicleManager.new()
local sonarManager   = SonarManager.new()
local ModeChanged    = Signal.new()

RunService.Heartbeat:Connect(function()
    safe(function()
        sonarManager:update()
    end)
end)

local function openScanMode()
    isLinked = false
    updateLinkStatus()
    sonarManager:clearAll()
    highlightNav("SCAN")
    ModeChanged:fire("SCAN")

    local root = getRoot()
    if not root then
        syncStatus("No character", Color3.fromRGB(255,0,0))
        syncMain("SCAN MODULE\n\nCharacter not found.")
        return
    end

    scanList = vehicleManager:getCarList()

    local filtered = {}
    for _,car in ipairs(scanList) do
        local p = getPrimary(car)
        if p and (p.Position - root.Position).Magnitude <= CONFIG.ScanRadius then
            table.insert(filtered,car)
        end
    end
    scanList = filtered

    if #scanList == 0 then
        syncStatus("No cars found", Color3.fromRGB(255,0,0))
        syncMain("SCAN MODULE\n\nNo vehicles detected around you.")
        return
    end

    sortByDistance(root.Position, scanList)

    scanIndex = 1
    lastScannedCar = scanList[1]

    local function showCar()
        local car = scanList[scanIndex]
        if not car or not car.Parent then return end

        vehicleManager:ensureAttributes(car)

        local p = getPrimary(car)
        local dist = (p.Position - root.Position).Magnitude
        local locked = getAttr(car, "Locked", true)

        syncStatus("Car "..scanIndex.." of "..#scanList, Color3.fromRGB(0,255,0))
        syncMain(
            "SCAN MODULE (PHONE MODE)\n\nVehicle "..scanIndex.."/"..#scanList..
            "\nName: "..car.Name..
            "\nDistance: "..math.floor(dist).." studs"..
            "\nLocked: "..tostring(locked)
        )

        prevBtn.Visible = (#scanList > 1)
        nextBtn.Visible = (#scanList > 1)
    end

    showCar()

    if prevConn then prevConn:Disconnect() end
    if nextConn then nextConn:Disconnect() end

    prevConn = prevBtn.MouseButton1Click:Connect(function()
        if scanIndex > 1 then
            scanIndex -= 1
            showCar()
        end
    end)

    nextConn = nextBtn.MouseButton1Click:Connect(function()
        if scanIndex < #scanList then
            scanIndex += 1
            showCar()
        end
    end)
end

local function openSpoofMode()
    isLinked = false
    updateLinkStatus()
    sonarManager:clearAll()
    highlightNav("SPOOF")
    ModeChanged:fire("SPOOF")

    prevBtn.Visible = false
    nextBtn.Visible = false

    if not lastScannedCar or not lastScannedCar.Parent then
        syncStatus("Scan a car first", Color3.fromRGB(255,170,0))
        syncMain("SPOOF MODULE\n\nNo vehicle selected.\nRun SCAN first.")
        return
    end

    vehicleManager:ensureAttributes(lastScannedCar)
    spoofKey(lastScannedCar)
end

local function openSonarMode()
    isLinked = false
    updateLinkStatus()
    sonarManager:clearAll()
    highlightNav("SONAR")
    ModeChanged:fire("SONAR")

    prevBtn.Visible = false
    nextBtn.Visible = false

    local cars = vehicleManager:getCarList()
    if #cars == 0 then
        syncStatus("No cars found", Color3.fromRGB(255,0,0))
        syncMain("SONAR MODULE\n\nNo vehicles detected in the world.")
        return
    end

    for _,car in ipairs(cars) do
        sonarManager:createDistanceUI(car)
    end

    syncStatus("SONAR tracking all vehicles", Color3.fromRGB(0,255,0))
    syncMain("SONAR MODULE\n\nTracking ALL vehicles.\nDistance labels update smoothly.")
end

local function openSettingsMode()
    isLinked = false
    updateLinkStatus()
    sonarManager:clearAll()
    highlightNav("SET")
    ModeChanged:fire("SET")

    prevBtn.Visible = false
    nextBtn.Visible = false

    syncStatus("Settings open", Color3.fromRGB(0,255,0))
    syncMain("SETTINGS MODULE\n\nKeybind: T\nTheme: Ultra Clean\nSync: Enabled\n\nValues are static in this build.")
end

local function exitAndReset()
    isLinked = false
    updateLinkStatus()
    sonarManager:clearAll()

    Mode:set("NONE")
    highlightNav("NONE")
    ModeChanged:fire("NONE")

    spoofedKeys    = {}
    lastScannedCar = nil
    scanList       = {}
    scanIndex      = 1

    prevBtn.Visible = false
    nextBtn.Visible = false

    syncStatus("Closed", Color3.fromRGB(255,170,0))
    syncMain("Select a module on the left.")

    tween(tablet, {BackgroundTransparency = 1}, 0.15)
    tablet.Visible = false
    syncVisibility()
    tablet.BackgroundTransparency = 0
end

