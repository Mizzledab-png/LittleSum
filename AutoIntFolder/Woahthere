local function openTablet()
    tab.Visible = true
    tween(tab, {Position = CFG.Pos}, .25):Play()

    if lastCar and lastCar.Parent then
        setText(("Reconnected to %s.\n\nSelect a module."):format(lastCar.Name))
        status.Text = "Status: Ready"
    else
        setText("AUTEL PROPAD READY\n\nSelect a module on the left.")
        status.Text = "Status: Idle"
    end
end

local function closeTablet()
    tween(tab, {Position = UDim2.new(.5,0,1.2,0)}, .25):Play()
    task.delay(.25, function()
        tab.Visible = false
    end)
end

