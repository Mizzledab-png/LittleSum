local function ACQUIRE()
    moduleTransition(function()
        status.Text = "Status: ACQ // ACTIVE"
        setText("<b>ACQUISITION SUITE</b>\n\nSelect a vehicle from the list on the right.")

        local list = buildVehicleList()
        if #list == 0 then
            setText("<b>ACQUISITION SUITE</b>\n\nNo vehicles detected.")
            status.Text = "Status: ACQ // COLD"
            return
        end

        local y = 0
        for _,entry in ipairs(list) do
            local car = entry.car
            local dist = math.floor(entry.dist)
            local displayName = getDisplayName(car, entry.seat)

            local btn = Instance.new("TextButton", scrollFrame)
            btn.Size = UDim2.new(1,-20,0,32)
            btn.Position = UDim2.new(0,10,0,y)
            btn.BackgroundColor3 = Color3.fromRGB(15,15,22)
            btn.Font = Enum.Font.Gotham
            btn.TextScaled = true
            btn.RichText = true
            btn.TextColor3 = Color3.fromRGB(240,240,245)
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.ZIndex = 6
            btn.Text = string.format("<b>%s</b> — <font color='rgb(220,40,40)'>%d studs</font>", displayName, dist)
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)

            btn.MouseEnter:Connect(function()
                tween(btn,{BackgroundColor3 = CFG.Col},0.15):Play()
            end)
            btn.MouseLeave:Connect(function()
                tween(btn,{BackgroundColor3 = Color3.fromRGB(15,15,22)},0.15):Play()
            end)

            btn.MouseButton1Click:Connect(function()
                setLastTarget(entry)
                setText(("<b>ACQUISITION SUITE</b>\n\nTarget locked:\n%s\n\nRange: <font color='rgb(220,40,40)'>%d studs</font>")
                    :format(displayName, dist))
                status.Text = "Status: ACQ // LOCKED"
            end)

            y += 36
        end

        scrollFrame.CanvasSize = UDim2.new(0,0,0,y)
    end)
end

