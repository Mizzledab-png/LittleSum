local function EXIT()
    -- Fade out UI text first
    setText("<b>SYSTEM EXIT</b>\n\nCollapsing SPECTRE interface...")
    status.Text = "Status: EXIT // COLLAPSE"

    task.wait(0.25)

    -- Clear panel buttons and text
    clearPanel()

    -- Collapse back to compact mode
    collapseToCompact()

    -- Reset status
    status.Text = "Status: Idle"
