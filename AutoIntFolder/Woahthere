    if not isFull then return end
    isFull = false

    tab.Visible = true
    spectralFlicker(tab)

    tween(full, {BackgroundTransparency = 1}, CFG.FadeTime):Play()
    tween(tab, {BackgroundTransparency = 0.15}, CFG.FadeTime):Play()

    task.delay(CFG.FadeTime, function()
        full.Visible = false
