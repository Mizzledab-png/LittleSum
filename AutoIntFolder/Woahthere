--========================================================--
-- TOGGLE TABLET
--========================================================--

local function toggleTablet()
    tablet.Visible = not tablet.Visible
    syncVisibility()

    if tablet.Visible then
        isLinked = false
        updateLinkStatus()
        clearAllSonarUI()
        highlightNav("NONE")
        syncStatus("Ready", Color3.fromRGB(0, 255, 0))
        syncMain("Select a module on the left.")
    else
        clearAllSonarUI()
    end
end

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.T then
        toggleTablet()
    end
end)

lp.Chatted:Connect(function(msg)
    if msg:lower() == "!autel" then
        toggleTablet()
    end
end)
