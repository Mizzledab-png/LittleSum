local VM = {cars = {}, primary = {}}
local lastCar = nil

-----------------------------------------------------
-- PRIMARY PART ASSIGNMENT (SPECTRE SILENT LOGIC)
-----------------------------------------------------
local function assignPrimaryPart(model)
    if model.PrimaryPart then return model.PrimaryPart end

    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            model.PrimaryPart = p
            return p
        end
    end

    return nil
end

-----------------------------------------------------
-- VALID CAR NAME CHECK
-----------------------------------------------------
local function isValidCarName(name)
    if not name then return false end
    name = name:lower()
    return name ~= "body" and name ~= "model" and name ~= "futon"
end

-----------------------------------------------------
-- REGISTER MODEL INTO VEHICLE MATRIX
-----------------------------------------------------
local function registerModel(model)
    if not model:IsA("Model") then return end
    if not isValidCarName(model.Name) then return end

    local seat = model:FindFirstChildWhichIsA("VehicleSeat", true)
    if not seat then return end

    local pp = assignPrimaryPart(model)
    if not pp then return end

    if not VM.primary[model] then
        VM.primary[model] = pp
        table.insert(VM.cars, model)
    end
end

-----------------------------------------------------
-- AUTO-REGISTER EXISTING VEHICLES
-----------------------------------------------------
for _, obj in ipairs(workspace:GetDescendants()) do
    if obj:IsA("VehicleSeat") then
        local m = obj:FindFirstAncestorWhichIsA("Model")
        if m then registerModel(m) end
    end
end

-----------------------------------------------------
-- REGISTER NEW VEHICLES AS THEY SPAWN
-----------------------------------------------------
workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("VehicleSeat") then
        local m = obj:FindFirstAncestorWhichIsA("Model")
        if m then registerModel(m) end
    end
end)

-----------------------------------------------------
-- CLEANUP WHEN VEHICLES DESPAWN
-----------------------------------------------------
workspace.ChildRemoved:Connect(function(model)
    if VM.primary[model] then
        VM.primary[model] = nil

        for i, v in ipairs(VM.cars) do
            if v == model then
                table.remove(VM.cars, i)
                break
            end
        end
    end

    if lastCar == model then
        lastCar = nil
    end
end)

-----------------------------------------------------
-- BUILD SORTED VEHICLE LIST (SPECTRE SILENT SCAN)
-----------------------------------------------------
local function buildVehicleList()
    local ok, r = pcall(root)
    if not ok or not r or not r.Parent then return {} end

    local list = {}

    for _, m in ipairs(VM.cars) do
        local p = VM.primary[m]
        if p and m.Parent then
            local dist = (p.Position - r.Position).Magnitude
            table.insert(list, {car = m, dist = dist})
        end
    end

    table.sort(list, function(a,b)
        return a.dist < b.dist
    end)

    return list
end

-- Expose for other modules
_G.AUTELPRO_SPECTRE = _G.AUTELPRO_SPECTRE or {}
_G.AUTELPRO_SPECTRE.buildVehicleList = buildVehicleList
_G.AUTELPRO_SPECTRE.VM = VM
_G.AUTELPRO_SPECTRE.lastCar = function() return lastCar end
