-- SECTION 2: VEHICLE REGISTRY
-------------------------------

local VM = {cars = {}, primary = {}}
local lastCar = nil

local function assignPrimaryPart(m)
    if m.PrimaryPart then return m.PrimaryPart end
    for _,p in ipairs(m:GetDescendants()) do
        if p:IsA("BasePart") then
            m.PrimaryPart = p
            return p
        end
    end
    return nil
end

local function registerModel(m)
    if not m:IsA("Model") then return end
    if not isValidCarName(m.Name) then return end

    local seat = m:FindFirstChildWhichIsA("VehicleSeat", true)
    if not seat then return end

    local pp = assignPrimaryPart(m)
    if not pp then return end

    if not VM.primary[m] then
        VM.primary[m] = pp
        table.insert(VM.cars, m)
    end
end

workspace.ChildRemoved:Connect(function(m)
    if VM.primary[m] then
        VM.primary[m] = nil
        for i,v in ipairs(VM.cars) do
            if v == m then
                table.remove(VM.cars, i)
                break
            end
        end
    end

    if lastCar == m then
        lastCar = nil
        if status then status.Text = "Status: Idle" end
        if setText then setText("TARGET LOST\n\nSelect new vehicle.") end
    end
end)

workspace.DescendantAdded:Connect(function(o)
    if o:IsA("VehicleSeat") then
        local m = o:FindFirstAncestorWhichIsA("Model")
        if m then registerModel(m) end
    end
end)

for _,o in ipairs(workspace:GetDescendants()) do
    if o:IsA("VehicleSeat") then
        local m = o:FindFirstAncestorWhichIsA("Model")
        if m then registerModel(m) end
    end
end

