local function expand()
    if isFull then return end
    isFull = true
    full.Visible = true
    tween(full,{BackgroundTransparency = 0})
    tween(tab,{BackgroundTransparency = 1})
    task.delay(CFG.FadeTime,function() tab.Visible = false end)
end

local function collapse()
    if not isFull then return end
    isFull = false
    tab.Visible = true
    tween(full,{BackgroundTransparency = 1})
    tween(tab,{BackgroundTransparency = 0.15})
    task.delay(CFG.FadeTime,function() full.Visible = false end)
end
local BAD_NAMES = {
    ["Ensure"] = true,
    ["Futon"] = true,
    ["Model"] = true,
    ["Body"] = true,
    ["Part"] = true,
    ["Seat"] = true,
    ["PartyST"] = true,
}

local VehicleCache = {}

local function classifyVehicle(model)
    if VehicleCache[model] ~= nil then
        return VehicleCache[model]
    end

    if BAD_NAMES[model.Name] then
        VehicleCache[model] = false
        return false
    end

    local hasSeat = false
    local partCount = 0

    for _,d in ipairs(model:GetChildren()) do
        if d:IsA("BasePart") then
            partCount += 1
        elseif d:IsA("VehicleSeat") or d:IsA("Seat") then
            hasSeat = true
        end
    end

    local isVehicle = (hasSeat and partCount >= 2)
    VehicleCache[model] = isVehicle
    return isVehicle
end

local function resolveVehicle(seat)
    local parent = seat.Parent
    while parent and parent ~= workspace do
        if parent:IsA("Model") and classifyVehicle(parent) then
            return parent
        end
        parent = parent.Parent
    end
    return seat
end
local VehicleDB = {}

local function registerSeat(seat)
    if not (seat:IsA("VehicleSeat") or seat:IsA("Seat")) then return end
    VehicleDB[seat] = {seat = seat, car = resolveVehicle(seat)}
end

local function unregisterSeat(inst)
    VehicleDB[inst] = nil
end

task.spawn(function()
    for _,obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") then
            classifyVehicle(obj)
        end
    end

    for _,obj in ipairs(workspace:GetDescendants()) do
        registerSeat(obj)
    end
end)

workspace.DescendantAdded:Connect(function(inst)
    if inst:IsA("Model") then
        classifyVehicle(inst)
    elseif inst:IsA("VehicleSeat") or inst:IsA("Seat") then
        registerSeat(inst)
    end
end)

workspace.DescendantRemoving:Connect(unregisterSeat)
local function buildList()
    local list = {}
    local char = plr.Character or plr.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    local rootPos = root.Position

    for seat,info in pairs(VehicleDB) do
        local car = info.car
        if car and car.Parent then
            local pos = car.PrimaryPart and car.PrimaryPart.Position or seat.Position
            table.insert(list,{
                car = car,
                seat = seat,
                dist = (pos - rootPos).Magnitude
            })
        end
    end

    table.sort(list,function(a,b) return a.dist < b.dist end)
    return list
end
local function makeBar(dist)
    local maxDist = 300
    local pct = math.clamp(dist / maxDist, 0, 1)

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0.6,0,0,6)
    bar.BackgroundColor3 = Color3.fromRGB(40,40,40)
    bar.BorderSizePixel = 0

    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new(pct,0,1,0)
    fill.BorderSizePixel = 0

    if pct < 0.33 then
        fill.BackgroundColor3 = Color3.fromRGB(0,255,0)
    elseif pct < 0.66 then
        fill.BackgroundColor3 = Color3.fromRGB(255,200,0)
    else
        fill.BackgroundColor3 = Color3.fromRGB(255,0,0)
    end

    return bar
end
local lastTarget = nil

local function ACQUIRE()
    scroll:ClearAllChildren()
    textLabel.Text = "<b>TARGET SELECTION</b>\nSelect a vehicle."
    status.Text = "Status: ACQ // ACTIVE"

    local list = buildList()
    local y = 0

    for _,entry in ipairs(list) do
        local car = entry.car
        local dist = math.floor(entry.dist)

        local btn = Instance.new("TextButton", scroll)
        btn.Size = UDim2.new(1,-20,0,40)
        btn.Position = UDim2.new(0,10,0,y)
        btn.BackgroundColor3 = Color3.fromRGB(15,15,22)
        btn.Font = Enum.Font.Gotham
        btn.TextScaled = true
        btn.RichText = true
        btn.TextColor3 = Color3.fromRGB(240,240,245)
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Text = string.format("<b>%s</b> — %d studs", car.Name, dist)

        local bar = makeBar(dist)
        bar.Position = UDim2.new(0.35,0,0.5,-3)
        bar.Parent = btn

        btn.MouseButton1Click:Connect(function()
            lastTarget = entry
            textLabel.Text = string.format("<b>TARGET LOCKED</b>\n%s\nDistance: %d studs", car.Name, dist)
            status.Text = "Status: ACQ // LOCKED"
        end)

        y += 45
    end

    scroll.CanvasSize = UDim2.new(0,0,0,y)
end
local function REPROGRAM()
    if not lastTarget then
        textLabel.Text = "<b>REPROGRAM</b>\nNo target selected."
        return
    end

    local car = lastTarget.car
    textLabel.Text = "<b>REPROGRAM</b>\nClearing seat restrictions..."
    status.Text = "Status: ECU // ACTIVE"

    for _,d in ipairs(car:GetDescendants()) do
        if d:GetAttribute("SeatDisabled") ~= nil then d:SetAttribute("SeatDisabled", false) end
        if d:GetAttribute("EngineDisabled") ~= nil then d:SetAttribute("EngineDisabled", false) end
        if d:GetAttribute("Immobilized") ~= nil then d:SetAttribute("Immobilized", false) end
    end

    textLabel.Text = "<b>REPROGRAM COMPLETE</b>\nSeat unlocked.\nObstacles cleared."
    status.Text = "Status: ECU // COMPLETE"
end
local function makeButton(label, order, callback)
    local b = Instance.new("TextButton", full)
    b.Size = UDim2.new(0,180,0,40)
    b.Position = UDim2.new(0.03,0,0.55 + ((order-1)*0.07),0)
    b.BackgroundColor3 = Color3.fromRGB(15,15,22)
    b.Font = Enum.Font.GothamBold
    b.TextScaled = true
    b.TextColor3 = Color3.fromRGB(240,240,245)
    b.Text = label
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)
    b.MouseButton1Click:Connect(callback)
end

local function buildButtons()
    makeButton("ACQUIRE",1,ACQUIRE)
    makeButton("REPROGRAM",2,REPROGRAM)
    makeButton("EXIT",3,function()
        scroll:ClearAllChildren()
        collapse()
    end)
end

