local function openScanMode()
    isLinked = false
    updateLinkStatus()
    sonarManager:clearAll()
    highlightNav("SCAN")
    ModeChanged:fire("SCAN")

    local root = getRoot()
    if not root then
        syncStatus("No character", CONFIG.Theme.StatusBad)
        syncMain("SCAN MODULE\n\nCharacter not found.")
        return
    end

    scanList = vehicleManager:getCarList()

    local filtered = {}
    for _,car in ipairs(scanList) do
        local p = getPrimary(car)
        if p and (p.Position - root.Position).Magnitude <= CONFIG.ScanRadius then
            table.insert(filtered, car)
        end
    end
    scanList = filtered

    if #scanList == 0 then
        syncStatus("No cars found", CONFIG.Theme.StatusBad)
        syncMain(
            "SCAN MODULE\n\n"..
            "No vehicles detected around you.\n\n"..
            "Move closer to vehicles and try again."
        )
        prevBtn.Visible = false
        nextBtn.Visible = false
        return
    end

    sortByDistance(root.Position, scanList)

    scanIndex = 1
    lastScannedCar = scanList[1]

    local function showCar()
        local car = scanList[scanIndex]
        if not car or not car.Parent then
            syncStatus("Vehicle missing", CONFIG.Theme.StatusWarn)
            return
        end

        vehicleManager:ensureAttributes(car)

        local p = getPrimary(car)
        if not p then
            syncStatus("No primary part", CONFIG.Theme.StatusWarn)
            return
        end

        local dist   = (p.Position - root.Position).Magnitude
        local locked = getAttr(car, "Locked", true)
        local key    = getAttr(car, "KeyCode", "N/A")

        syncStatus("Car "..scanIndex.." of "..#scanList, CONFIG.Theme.StatusGood)
        syncMain(
            "SCAN MODULE (PHONE MODE)\n\n"..
            "Vehicle "..scanIndex.."/"..#scanList..
            "\nName: "..car.Name..
            "\nDistance: "..math.floor(dist).." studs"..
            "\nLocked: "..tostring(locked)..
            "\nKeyCode: "..tostring(key)
        )

        prevBtn.Visible = (#scanList > 1)
        nextBtn.Visible = (#scanList > 1)
    end

    showCar()

    if prevConn then prevConn:Disconnect() end
    if nextConn then nextConn:Disconnect() end

    prevConn = prevBtn.MouseButton1Click:Connect(function()
        if scanIndex > 1 then
            scanIndex -= 1
            lastScannedCar = scanList[scanIndex]
            showCar()
        end
    end)

    nextConn = nextBtn.MouseButton1Click:Connect(function()
        if scanIndex < #scanList then
            scanIndex += 1
            lastScannedCar = scanList[scanIndex]
            showCar()
        end
    end)
end

local function openSpoofMode()
    isLinked = false
    updateLinkStatus()
    sonarManager:clearAll()
    highlightNav("SPOOF")
    ModeChanged:fire("SPOOF")

    prevBtn.Visible = false
    nextBtn.Visible = false

