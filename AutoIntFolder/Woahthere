local function tween(o,p,t)
    return ts:Create(o, TweenInfo.new(t or .25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), p)
end

local function isValidCarName(name)
    if not name then return false end
    name = name:lower()
    return name ~= "body" and name ~= "model" and name ~= "futon"
end

local function getSignalBars(dist)
    if dist <= 30 then
        return "<font color='rgb(0,255,0)'>▂▃▅</font>"
    elseif dist <= 100 then
        return "<font color='rgb(255,255,0)'>▂▃</font>"
    elseif dist <= 199 then
        return "<font color='rgb(255,255,0)'>▂</font>"
    else
        return "<font color='rgb(255,0,0)'>▂</font>"
    end
end

local function getProgressBar(pct)
    local filled = math.floor(pct/10)
    local empty = 10 - filled
    local bar = ""
    for _ = 1,filled do
        bar = bar .. "<font color='rgb(220,40,40)'>▂</font>"
    end
    for _ = 1,empty do
        bar = bar .. "<font color='rgb(60,60,60)'>▂</font>"
    end
    return bar
end

local function root()
    local c = plr.Character or plr.CharacterAdded:Wait()
    return c:WaitForChild("HumanoidRootPart")
end

