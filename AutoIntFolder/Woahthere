-----------------------------------------------------
-- BUTTON CREATOR
-----------------------------------------------------
local function makeButton(label, order, callback)
    local b = Instance.new("TextButton", panel)
    b.Size = UDim2.new(0, 180, 0, 40)
    b.Position = UDim2.new(0, 10 + ((order-1) * 190), 0, 10)
    b.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
    b.Font = Enum.Font.GothamBold
    b.TextScaled = true
    b.TextColor3 = Color3.fromRGB(240, 240, 245)
    b.Text = label
    b.RichText = true

    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

    b.MouseEnter:Connect(function()
        tween(b, {BackgroundColor3 = CFG.Col}, 0.15):Play()
    end)

    b.MouseLeave:Connect(function()
        tween(b, {BackgroundColor3 = Color3.fromRGB(15,15,22)}, 0.15):Play()
    end)

    b.MouseButton1Click:Connect(function()
        callback()
    end)
end

-----------------------------------------------------
-- BUILD BUTTON PANEL
-----------------------------------------------------
local function BUILD_BUTTON_PANEL()
    -- Clear old buttons
    for _, v in ipairs(panel:GetChildren()) do
        if v:IsA("TextButton") then
            v:Destroy()
        end
    end

    -- Create new buttons
    makeButton("ACQUIRE", 1, ACQUIRE)
    makeButton("ECU",     2, ECU)
    makeButton("KEY",     3, KEY)
    makeButton("SCAN",    4, SCAN)
    makeButton("EXIT",    5, EXIT)
end

-- Expose
_G.AUTELPRO_SPECTRE.BUILD_BUTTON_PANEL = BUILD_BUTTON_PANEL
