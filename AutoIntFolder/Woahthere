local activeBillboard = nil
local liveUpdater = nil
local listUpdater = nil
local progressUpdater = nil

local function disconnectConn(c)
    if c then c:Disconnect() end
end

local function clearSonarUI()
    sonarList.Visible = false
    sonarList.CanvasSize = UDim2.new(0,0,0,0)

    local children = sonarList:GetChildren()
    for i = 1,#children do
        local v = children[i]
        if v:IsA("TextButton") then
            v:Destroy()
        end
    end

    if activeBillboard then
        activeBillboard:Destroy()
        activeBillboard = nil
    end

    disconnectConn(liveUpdater)
    disconnectConn(listUpdater)
    disconnectConn(progressUpdater)

    liveUpdater = nil
    listUpdater = nil
    progressUpdater = nil

    progressLabel.Text = ""
end

local function showTargetUI(car)
    if activeBillboard then activeBillboard:Destroy() end
    disconnectConn(liveUpdater)
    disconnectConn(progressUpdater)
    progressLabel.Text = ""

    local p = VM.primary[car]
    if not p then return end

    local pct = 0
    progressUpdater = rs.Heartbeat:Connect(function()
        if not car.Parent then
            progressLabel.Text = "<font color='rgb(255,0,0)'>TARGET LOST</font>"
            disconnectConn(progressUpdater)
            progressUpdater = nil
            return
        end

        if pct < 100 then
            pct = math.min(pct + 2, 100)
            progressLabel.Text = getProgressBar(pct)
            return
        end

        progressLabel.Text = "<font color='rgb(0,255,0)'>COMPLETE</font>"
        disconnectConn(progressUpdater)
        progressUpdater = nil

        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0,150,0,45)
        bb.AlwaysOnTop = true
        bb.Adornee = p
        bb.Parent = car
        activeBillboard = bb

        local lb = Instance.new("TextLabel")
        lb.Size = UDim2.new(1,0,1,0)
        lb.BackgroundTransparency = 1
        lb.Font = Enum.Font.GothamBold
        lb.TextScaled = true
        lb.TextColor3 = Color3.fromRGB(255,60,60)
        lb.Parent = bb

        liveUpdater = rs.Heartbeat:Connect(function()
            if not car.Parent then
                lb.Text = "Lost Target"
                return
            end

            local r = root()
            if not r or not r.Parent then
                lb.Text = car.Name .. "\nN/A"
                return
            end

            local d = math.floor((p.Position - r.Position).Magnitude)
            lb.Text = ("%s\n%d studs"):format(car.Name, d)
        end)
    end)
end

local function buildVehicleList()
    local r = root()
    if not r or not r.Parent then return {} end

    local list = {}
    local cars = VM.cars
    for i = 1,#cars do
        local m = cars[i]
        local p = VM.primary[m]
        if p and m.Parent then
            local d = (p.Position - r.Position).Magnitude
            list[#list+1] = {car = m, dist = d}
        end
    end

    table.sort(list, function(a,b)
        return a.dist < b.dist
    end)

    return list
end

-------------------------------------------------
-- CONNECTIONS MODULE
-------------------------------------------------

local function CONNECTIONS()
    clearSonarUI()

    local list = buildVehicleList()
    local count = #list
    if count == 0 then
        setText("CONNECTIONS MODE\n\nNo vehicles detected.")
        return
    end

    setText("CONNECTIONS MODE\n\nSelect a target below:")
    sonarList.Visible = true

    local buttons = {}

    for i = 1,count do
        local e = list[i]
        local car = e.car

        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1,0,0,22)
        b.BackgroundTransparency = 1
        b.TextColor3 = Color3.new(1,1,1)
        b.Font = Enum.Font.Gotham
        b.TextSize = 14
        b.RichText = true
        b.TextXAlignment = Enum.TextXAlignment.Left
        b.Parent = sonarList

        local dist = math.floor(e.dist)
        b.Text = string.format("%s  %s  (%d studs)",
            car.Name,
            getSignalBars(dist),
            dist
        )

        buttons[car] = b

        b.MouseButton1Click:Connect(function()
            lastCar = car
            clearSonarUI()
            setText(("CONNECTION LOCKED\n\n%s\n\n<font size='18'>GPS Booting</font>"):format(car.Name))
            showTargetUI(car)
        end)
    end

    sonarList.CanvasSize = UDim2.new(0,0,0,count * 26)

    disconnectConn(listUpdater)
    listUpdater = rs.Heartbeat:Connect(function()
        local r = root()
        if not r or not r.Parent then return end

        for car,button in pairs(buttons) do
            if car and car.Parent then
                local p = VM.primary[car]
                if p then
                    local d = math.floor((p.Position - r.Position).Magnitude)
                    button.Text = string.format("%s  %s  (%d studs)",
                        car.Name,
                        getSignalBars(d),
                        d
                    )
                end
            else
                button.Text = (car and car.Name or "Unknown") .. " (lost)"
            end
        end
    end)
end

-------------------------------------------------
-- REPROGRAM MODULE
-------------------------------------------------

local function REPROGRAM()
    clearSonarUI()

    if not lastCar or not lastCar.Parent then
        setText("REPROGRAM MODE\n\nNo target selected.\nUse Connections first.")
        status.Text = "Status: Idle"
        return
    end

    status.Text = "Status: Working"

    -- Fake diagnostic log messages
    local logs = {
        "Initializing CAN handshake...",
        "Reading ECU firmware blocks...",
        "Bypassing immobilizer seed...",
        "Decrypting rolling key...",
        "Injecting spoofed transponder ID...",
        "Writing override packet...",
        "Clearing engine lock flags...",
        "Finalizing ECU handshake...",
        "Verifying rewrite integrity...",
        "Completing reprogram sequence..."
    }

    local logIndex = 1
    setText(("REPROGRAM MODE\n\nVehicle: %s\n%s"):format(lastCar.Name, logs[logIndex]))

    local pct = 0
    disconnectConn(progressUpdater)

    progressUpdater = rs.Heartbeat:Connect(function()
        if not lastCar or not lastCar.Parent then
            progressLabel.Text = "<font color='rgb(255,0,0)'>TARGET LOST</font>"
            disconnectConn(progressUpdater)
            progressUpdater = nil
            return
        end

        -- Update progress bar
        if pct < 100 then
            pct = math.min(pct + 2, 100)
            progressLabel.Text = getProgressBar(pct)

            -- Every 10% → advance diagnostic log
            local newIndex = math.clamp(math.floor(pct / 10) + 1, 1, #logs)
            if newIndex ~= logIndex then
                logIndex = newIndex
                setText(("REPROGRAM MODE\n\nVehicle: %s\n%s"):format(lastCar.Name, logs[logIndex]))
            end

            return
        end

        -- COMPLETE
        progressLabel.Text = "<font color='rgb(0,255,0)'>COMPLETE</font>"
        disconnectConn(progressUpdater)
        progressUpdater = nil

        -- Perform the actual reprogramming AFTER the bar finishes
        local descendants = lastCar:GetDescendants()
        for i = 1,#descendants do
            local d = descendants[i]

            if d:IsA("VehicleSeat") or d:IsA("Seat") then
                d.Disabled = false
                d:Sit(nil)
            end

            if d:IsA("BasePart") then
                d.Anchored = false
            end

            if d:GetAttribute("EngineDisabled") ~= nil then
                d:SetAttribute("EngineDisabled", false)
            end

            if d:GetAttribute("Immobilized") ~= nil then
                d:SetAttribute("Immobilized", false)
            end
        end

        setText(("REPROGRAM MODE\n\nVehicle: %s\nStatus: Key Stolen."):format(lastCar.Name))
        status.Text = "Status: Spoofed"
    end)
end

-------------------------------------------------
-- SCAN MODULE
-------------------------------------------------

local function SCAN()
    clearSonarUI()

    local list = buildVehicleList()
    local count = #list
    if count == 0 then
        setText("SCAN MODE\n\nNo vehicles detected.")
        status.Text = "Status: Scan complete (0)"
        return
    end

    local nearest = list[1]
    local farthest = list[count]

    local sum = 0
    for i = 1,count do
        sum += list[i].dist
    end

    local avg = math.floor(sum / count)

    local text = string.format(
        "SCAN MODE\n\nVehicles detected: %d\n\nNearest: %s (%.0f studs)\nFarthest: %s (%.0f studs)\nAverage distance: %d studs",
        count,
        nearest.car.Name, nearest.dist,
        farthest.car.Name, farthest.dist,
        avg
    )

    setText(text)
    status.Text = "Status: Scan complete ("..count..")"
end

