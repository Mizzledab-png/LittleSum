local function btn(name, order, callback)
    local b = Instance.new("TextButton", nav)
    b.Size = UDim2.new(1,0,0,30)
    b.Position = UDim2.new(0,0,0,(order-1)*34)
    b.BackgroundColor3 = Color3.fromRGB(20,20,26)
    b.Font = Enum.Font.GothamBold
    b.TextColor3 = Color3.fromRGB(240,240,245)
    b.TextScaled = true
    b.Text = name
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)

    b.MouseEnter:Connect(function()
        tween(b,{BackgroundColor3=CFG.Col},.15):Play()
    end)

    b.MouseLeave:Connect(function()
        tween(b,{BackgroundColor3=Color3.fromRGB(20,20,26)},.15):Play()
    end)

    b.MouseButton1Click:Connect(callback)
end

