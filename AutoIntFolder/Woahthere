-- UNBREAKABLE VEHICLE RESOLVER
local function resolveVehicle(seat)
    local parent = seat.Parent

    while parent do
        if parent:IsA("Model") then
            local parts = parent:GetDescendants()
            local count = 0
            for _,p in ipairs(parts) do
                if p:IsA("BasePart") then
                    count += 1
                    if count >= 4 then
                        return parent -- treat as real vehicle
                    end
                end
            end
        end
        parent = parent.Parent
    end

    return seat -- fallback: seat is the vehicle
end

-- LIVE VEHICLE DATABASE
local VehicleDB = {}

local function registerSeat(seat)
    if not (seat:IsA("VehicleSeat") or seat:IsA("Seat")) then return end
    local car = resolveVehicle(seat)
    VehicleDB[seat] = {
        seat = seat,
        car = car
    }
end

local function unregisterSeat(inst)
    if VehicleDB[inst] then VehicleDB[inst] = nil end
end

local function initialSeatScan()
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("VehicleSeat") or obj:IsA("Seat") then
            registerSeat(obj)
        end
    end
end

