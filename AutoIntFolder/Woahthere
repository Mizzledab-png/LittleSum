-----------------------------
-- TABLET TOGGLE
-----------------------------
local toggleCooldown = Cooldown.new(CONFIG.ToggleCooldown)

local function resetTabletState()
    isLinked = false
    updateLinkStatus()
    sonarManager:clearAll()
    highlightNav("NONE")
    ModeChanged:fire("NONE")

    prevBtn.Visible = false
    nextBtn.Visible = false

    syncStatus("Ready", CONFIG.Theme.StatusGood)
    syncMain("Select a module on the left.")
end

local function toggleTablet()
    if not toggleCooldown:ready() then return end

    local newVisible = not tablet.Visible
    tablet.Visible = newVisible
    syncVisibility()

    if newVisible then
        resetTabletState()
        tablet.BackgroundTransparency = 1
        tween(tablet, {BackgroundTransparency = 0}, 0.15)
    else
        sonarManager:clearAll()
        prevBtn.Visible = false
        nextBtn.Visible = false
    end
end

UserInput.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == CONFIG.ToggleKey then
        toggleTablet()
    end
end)

LocalPlayer.Chatted:Connect(function(msg)
    if msg:lower() == CONFIG.ChatCommand then
        toggleTablet()
    end
end)
