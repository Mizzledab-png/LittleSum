-- OPEN/CLOSE
local isOpen = false

local function openPropad()
    if isOpen then return end
    isOpen = true
    full.Visible = true
    tween(full,{BackgroundTransparency = 0})
end

local function closePropad()
    if not isOpen then return end
    isOpen = false
    tween(full,{BackgroundTransparency = 1})
    task.delay(CFG.FadeTime,function()
        full.Visible = false
    end)
end

-- VEHICLE DETECTION (BRONX 3)
local function isSeat(obj)
    if obj:IsA("VehicleSeat") or obj:IsA("Seat") then return true end
    local n = obj.Name:lower()
    return n:find("seat") or n:find("driver") or n:find("pilot")
end

local BAD_NAMES = {
    ["ensure"] = true,
    ["futon"] = true,
    ["model"] = true,
    ["body"] = true,
    ["part"] = true,
    ["seat"] = true,
    ["partyst"] = true,
}

local VehicleCache = {}

local function classifyVehicle(model)
    if VehicleCache[model] ~= nil then
        return VehicleCache[model]
    end

    if BAD_NAMES[model.Name:lower()] then
        VehicleCache[model] = false
        return false
    end

    local hasSeat = false
    local partCount = 0

    for _,d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            partCount += 1
        elseif isSeat(d) then
            hasSeat = true
        end
        if partCount >= 4 and hasSeat then
            VehicleCache[model] = true
            return true
        end
    end

    VehicleCache[model] = false
    return false
end

local function resolveVehicle(seat)
    local parent = seat.Parent
    while parent and parent ~= workspace do
        if parent:IsA("Model") and classifyVehicle(parent) then
            return parent
        end
        parent = parent.Parent
    end
    return seat
end

-- VEHICLE DB
local VehicleDB = {}

local function registerSeat(obj)
    if not isSeat(obj) then return end

    local parent = obj.Parent
    while parent and parent ~= workspace do
        if parent:IsA("Model") then
            VehicleCache[parent] = nil
            classifyVehicle(parent)
        end
        parent = parent.Parent
    end

    VehicleDB[obj] = {
        seat = obj,
        car = resolveVehicle(obj)
    }
end

local function unregisterSeat(inst)
    VehicleDB[inst] = nil
end

task.spawn(function()
    for _,obj in ipairs(workspace:GetDescendants()) do
        registerSeat(obj)
    end
end)

workspace.DescendantAdded:Connect(function(inst)
    if isSeat(inst) then
        registerSeat(inst)
    elseif inst:IsA("Model") then
        VehicleCache[inst] = nil
        classifyVehicle(inst)
    end
end)

workspace.DescendantRemoving:Connect(unregisterSeat)

-- SAFE POSITION
local function getCarPosition(car, seat)
    if car:IsA("Model") then
        if car.PrimaryPart then
            return car.PrimaryPart.Position
        end
        for _,child in ipairs(car:GetDescendants()) do
            if child:IsA("BasePart") then
                return child.Position
            end
        end
    end
    return seat.Position
end

-- BUILD LIST
local function buildList()
    local list = {}
    local char = plr.Character or plr.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    local rootPos = root.Position

    for seat,info in pairs(VehicleDB) do
        local car = info.car
        if car and car.Parent then
            local pos = getCarPosition(car, seat)
            table.insert(list,{
                car = car,
                seat = seat,
                dist = (pos - rootPos).Magnitude
            })
        end
    end

    table.sort(list,function(a,b) return a.dist < b.dist end)
    return list
end

-- DIST BAR
local function makeBar(dist)
    local maxDist = 300
    local pct = math.clamp(dist / maxDist, 0, 1)

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0.6,0,0,6)
    bar.BackgroundColor3 = Color3.fromRGB(40,40,40)
    bar.BorderSizePixel = 0

    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new(pct,0,1,0)
    fill.BorderSizePixel = 0

    if pct < 0.33 then
        fill.BackgroundColor3 = Color3.fromRGB(0,255,0)
    elseif pct < 0.66 then
        fill.BackgroundColor3 = Color3.fromRGB(255,200,0)
    else
        fill.BackgroundColor3 = Color3.fromRGB(255,0,0)
    end

    return bar
end

-- TARGET + TRACKING
local lastTarget = nil
local trackedCar = nil
local trackedSeat = nil

local function ACQUIRE()
    scroll:ClearAllChildren()
    textLabel.Text = "<b>TARGET SELECTION</b>\nSelect a vehicle."
    status.Text = "Status: ACQ // ACTIVE"

    local list = buildList()
    local y = 0

    for _,entry in ipairs(list) do
        local car = entry.car
        local dist = math.floor(entry.dist)

        local btn = Instance.new("TextButton", scroll)
        btn.Size = UDim2.new(1,-20,0,40)
        btn.Position = UDim2.new(0,10,0,y)
        btn.BackgroundColor3 = Color3.fromRGB(15,15,22)
        btn.Font = Enum.Font.Gotham
        btn.TextScaled = true
        btn.RichText = true
        btn.TextColor3 = Color3.fromRGB(240,240,245)
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Text = string.format("<b>%s</b> — %d studs", car.Name, dist)

        local bar = makeBar(dist)
        bar.Position = UDim2.new(0.35,0,0.5,-3)
        bar.Parent = btn

        btn.MouseButton1Click:Connect(function()
            lastTarget = entry
            trackedCar = entry.car
            trackedSeat = entry.seat

            textLabel.Text = string.format("<b>TARGET LOCKED</b>\n%s\nDistance: %d studs", car.Name, dist)
            status.Text = "Status: ACQ // LOCKED"
        end)

        y += 45
    end

    scroll.CanvasSize = UDim2.new(0,0,0,y)
end

-- PERMANENT SEAT UNLOCK + TRACKING
RunService.Heartbeat:Connect(function()
    if trackedCar and trackedCar.Parent then
        for _,d in ipairs(trackedCar:GetDescendants()) do
            if d:GetAttribute("SeatDisabled") ~= nil then d:SetAttribute("SeatDisabled", false) end
            if d:GetAttribute("EngineDisabled") ~= nil then d:SetAttribute("EngineDisabled", false) end
            if d:GetAttribute("Immobilized") ~= nil then d:SetAttribute("Immobilized", false) end
        end

        local pos = getCarPosition(trackedCar, trackedSeat)
        local char = plr.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (pos - root.Position).Magnitude
                status.Text = string.format("Tracking: %s  |  %.1f studs", trackedCar.Name, dist)
            end
        end
    end
end)

-- REPROGRAM
local function REPROGRAM()
    if not trackedCar then
        textLabel.Text = "<b>REPROGRAM</b>\nNo target selected."
        return
    end

    textLabel.Text = "<b>REPROGRAM</b>\nClearing seat restrictions..."
    status.Text = "Status: ECU // ACTIVE"

    for _,d in ipairs(trackedCar:GetDescendants()) do
        if d:GetAttribute("SeatDisabled") ~= nil then d:SetAttribute("SeatDisabled", false) end
        if d:GetAttribute("EngineDisabled") ~= nil then d:SetAttribute("EngineDisabled", false) end
        if d:GetAttribute("Immobilized") ~= nil then d:SetAttribute("Immobilized", false) end
    end

    textLabel.Text = "<b>REPROGRAM COMPLETE</b>\nSeat unlocked.\nObstacles cleared."
    status.Text = "Status: ECU // COMPLETE"
end

