local activeBillboard = nil
local liveUpdater = nil
local listUpdater = nil
local progressUpdater = nil

local function disconnectConn(c)
    if c then c:Disconnect() end
end

local function clearSonarUI()
    sonarList.Visible = false
    sonarList.CanvasSize = UDim2.new(0,0,0,0)

    for _,v in ipairs(sonarList:GetChildren()) do
        if v:IsA("TextButton") then v:Destroy() end
    end

    if activeBillboard then
        activeBillboard:Destroy()
        activeBillboard = nil
    end

    disconnectConn(liveUpdater)
    disconnectConn(listUpdater)
    disconnectConn(progressUpdater)

    liveUpdater = nil
    listUpdater = nil
    progressUpdater = nil

    progressLabel.Text = ""
end

local function showTargetUI(car)
    if activeBillboard then activeBillboard:Destroy() end
    disconnectConn(liveUpdater)
    disconnectConn(progressUpdater)
    progressLabel.Text = ""

    local p = VM.primary[car]
    if not p then return end

    -- PROGRESS FIRST, NO UI YET
    local pct = 0
    progressUpdater = rs.Heartbeat:Connect(function()
        if pct < 100 then
            pct = math.min(pct + 2, 100)
            progressLabel.Text = getProgressBar(pct)
        else
            progressLabel.Text = "<font color='rgb(0,255,0)'>COMPLETE</font>"
            disconnectConn(progressUpdater)
            progressUpdater = nil

            -- ONLY NOW CREATE THE BILLBOARD UI
            local bb = Instance.new("BillboardGui")
            bb.Size = UDim2.new(0,150,0,45)
            bb.AlwaysOnTop = true
            bb.Adornee = p
            bb.Parent = car
            activeBillboard = bb

            local lb = Instance.new("TextLabel", bb)
            lb.Size = UDim2.new(1,0,1,0)
            lb.BackgroundTransparency = 1
            lb.Font = Enum.Font.GothamBold
            lb.TextScaled = true
            lb.TextColor3 = Color3.fromRGB(255,60,60)

            liveUpdater = rs.Heartbeat:Connect(function()
                if not car.Parent then
                    lb.Text = "Lost Target"
                    return
                end

                local ok, r = pcall(root)
                if not ok or not r or not r.Parent then
                    lb.Text = car.Name .. "\nN/A"
                    return
                end

                local d = math.floor((p.Position - r.Position).Magnitude)
                lb.Text = ("%s\n%d studs"):format(car.Name, d)
            end)
        end
    end)
end


local lastCar = nil

local function buildVehicleList()
    local ok, r = pcall(root)
    if not ok or not r or not r.Parent then return {} end

    local list = {}
    for _,m in ipairs(VM.cars) do
        local p = VM.primary[m]
        if p and m.Parent then
            local d = (p.Position - r.Position).Magnitude
            table.insert(list, {car = m, dist = d})
        end
    end

    table.sort(list, function(a,b) return a.dist < b.dist end)
    return list
end

-- CONNECTIONS MODULE
local function CONNECTIONS()
    clearSonarUI()

    local list = buildVehicleList()
    if #list == 0 then
        setText("CONNECTIONS MODE\n\nNo vehicles detected.")
        return
    end

    setText("CONNECTIONS MODE\n\nSelect a target below:")
    sonarList.Visible = true

    local buttons = {}

    for _,e in ipairs(list) do
        local b = Instance.new("TextButton", sonarList)
        b.Size = UDim2.new(1,0,0,22)
        b.BackgroundTransparency = 1
        b.TextColor3 = Color3.new(1,1,1)
        b.Font = Enum.Font.Gotham
        b.TextSize = 14
        b.RichText = true
        b.TextXAlignment = Enum.TextXAlignment.Left

        b.Text = string.format("%s  %s  (%d studs)", e.car.Name, getSignalBars(e.dist), math.floor(e.dist))
        buttons[e.car] = b

        b.MouseButton1Click:Connect(function()
            lastCar = e.car
            clearSonarUI()
            setText(("CONNECTION LOCKED\n\n%s\n\n<font size='18'>Reprogram Progression</font>"):format(e.car.Name))
            showTargetUI(e.car)
        end)
    end

    sonarList.CanvasSize = UDim2.new(0,0,0,#list * 26)

    disconnectConn(listUpdater)
    listUpdater = rs.Heartbeat:Connect(function()
        local ok, r = pcall(root)
        if not ok or not r or not r.Parent then return end

        for car,button in pairs(buttons) do
            if car and car.Parent then
                local p = VM.primary[car]
                if p then
                    local d = math.floor((p.Position - r.Position).Magnitude)
                    button.Text = string.format("%s  %s  (%d studs)", car.Name, getSignalBars(d), d)
                end
            else
                button.Text = (car and car.Name or "Unknown") .. " (lost)"
            end
        end
    end)
end

-- REPROGRAM MODULE
local function REPROGRAM()
    clearSonarUI()

    if not lastCar or not lastCar.Parent then
        setText("REPROGRAM MODE\n\nNo target selected.\nUse Connections first.")
        status.Text = "Status: Idle"
        return
    end

    -- collect all relevant parts first
    local parts = {}
    for _,d in ipairs(lastCar:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Seat") or d:IsA("VehicleSeat") then
            table.insert(parts, d)
        end
    end

    -- apply changes gradually to avoid detection
    local index = 1
    local conn
    conn = rs.Heartbeat:Connect(function()
        if index > #parts then
            conn:Disconnect()
            conn = nil
            return
        end

        local d = parts[index]
        if d and d.Parent then
            -- unanchor safely
            pcall(function()
                if d:IsA("BasePart") then
                    d.Anchored = false
                end
            end)

            -- restore attributes quietly
            pcall(function()
                if d:GetAttribute("EngineDisabled") ~= nil then
                    d:SetAttribute("EngineDisabled", false)
                end
            end)

            pcall(function()
                if d:GetAttribute("Immobilized") ~= nil then
                    d:SetAttribute("Immobilized", false)
                end
            end)
        end

        index += 1
    end)

    setText(("REPROGRAM MODE\n\nVehicle: %s\nStatus: Key Stolen."):format(lastCar.Name))
    status.Text = "Status: Spoofed"
end

-- SCAN MODULE
local function SCAN()
    clearSonarUI()

    local list = buildVehicleList()
    if #list == 0 then
        setText("SCAN MODE\n\nNo vehicles detected.")
        status.Text = "Status: Scan complete (0)"
        return
    end

    local count = #list
    local nearest = list[1]
    local farthest = list[#list]

    local sum = 0
    for _,e in ipairs(list) do sum += e.dist end
    local avg = math.floor(sum / count)

    local text = string.format(
        "SCAN MODE\n\nVehicles detected: %d\n\nNearest: %s (%.0f studs)\nFarthest: %s (%.0f studs)\nAverage distance: %d studs",
        count,
        nearest.car.Name, nearest.dist,
        farthest.car.Name, farthest.dist,
        avg
    )

    setText(text)
    status.Text = "Status: Scan complete ("..count..")"
end

